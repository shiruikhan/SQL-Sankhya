<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  Nome do Script : FechAssistIntTecnico
  Tipo           : Relatório Jasper (.jrxml)
  Grupo          : 36 - Fechamento Assistência Interna Técnico
  Descrição      : Relação de pagamentos ao técnico da assistência interna.
                   Chamado a partir da tela de O.S. de assistência (AD_TGFASS);
                   resume o VLRSERVTECNICO por técnico (AD_TGFASS.TECNICO ->
                   AD_CADFUNC.NOME), STATUS da O.S. e AD_TGFASS.MESFOLHA
                   (identificador do mês/ano em que o valor foi pago ao
                   técnico), em uma tabela simples, sem quebra de página por
                   técnico.
                   Cabeçalho simples com os dados da empresa 1 (Spark Eletrônica
                   — TSIEMP) e logo. Colunas: Técnico | Status | Nr. de O.S.
                   atendidas | Mês da folha | Soma do VLRSERVTECNICO. Total geral no final.

  Parâmetros     : PK_NUMOS   — NUMOS (chave de AD_TGFASS) do lançamento
                                selecionado na tela. Injetado pelo Sankhya.
                   P_MESFOLHA — (opcional) mês da folha a listar.
                   P_STATUS   — (opcional) código do STATUS; em branco lista todos
                                os status (uma linha por status).
                   P_MESFOLHA em branco assume o MESFOLHA do lançamento de
                   PK_NUMOS. O relatório lista TODOS os técnicos das O.S. com
                   esse MESFOLHA, em uma tabela única, sem quebra por técnico.
                   O Sankhya não repassa a seleção múltipla: com vários
                   lançamentos selecionados executa o relatório uma vez por
                   registro (uma folha por registro). Para sair uma folha só,
                   imprimir com UM lançamento selecionado ou informar
                   P_MESFOLHA/P_STATUS.

  Tabelas        : AD_TGFASS  : O.S. de assistência (leitura)
                   AD_CADFUNC : cadastro de funcionários — nome do técnico
                   TSIEMP / TSIEND / TSIBAI / TSICID / TSIUFS : dados da empresa 1

  Empresa        : Spark Eletrônica
  Autor          : Silvio Vieira
  Cargo          : Analista de Sistemas Sênior
  Data de Criação: 30/09/2026
  Última Revisão : Setembro/2026 — Criação

  Observações    : - O.S. sem técnico aparece como "SEM TÉCNICO" (comparação de
                     MESFOLHA é null-safe via DECODE).
                   - STATUS é campo de lista e é exibido pelo texto da opção
                     (TDDCAM/TDDOPC), com fallback para o código. Cada técnico
                     tem uma linha por STATUS.
                   - A empresa do cabeçalho é fixa (CODEMP = 1).
  ==============================================================================
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FechAssistIntTecnico" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoDataSection">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PK_NUMOS" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[Nr. OS]]></parameterDescription>
	</parameter>
	<parameter name="P_MESFOLHA" class="java.lang.String">
		<parameterDescription><![CDATA[Mês da folha (opcional; em branco usa o do lançamento selecionado)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_STATUS" class="java.lang.String">
		<parameterDescription><![CDATA[Status da O.S. (opcional; em branco lista todos os status)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT ASS.TECNICO,
    NVL(FUN.NOME, 'SEM TÉCNICO') AS NOMETECNICO,
    NVL(ASS.MESFOLHA, 'NÃO INFORMADO') AS MESFOLHA,
    NVL((SELECT MAX(OPC.OPCAO)
           FROM TDDOPC OPC
          INNER JOIN TDDCAM CAM ON CAM.NUCAMPO = OPC.NUCAMPO
          WHERE CAM.NOMETAB   = 'AD_TGFASS'
            AND CAM.NOMECAMPO = 'STATUS'
            AND OPC.VALOR     = ASS.STATUS), ASS.STATUS) AS STATUS,
    COUNT(*) AS QTD_OS,
    SUM(NVL(ASS.VLRSERVTECNICO, 0)) AS VLRSERVTECNICO,
    EMP.RAZAOSOCIAL AS EMP_RAZAO,
    EMPEDN.NOMEEND || ', ' || EMP.NUMEND
        || CASE WHEN EMP.COMPLEMENTO IS NOT NULL THEN ' - ' || EMP.COMPLEMENTO END
        || CASE WHEN EMPBAI.NOMEBAI IS NOT NULL THEN ' - ' || EMPBAI.NOMEBAI END AS EMP_ENDERECO,
    EMPCID.NOMECID || '/' || EMPUFS.UF || ' - CEP ' || EMP.CEP AS EMP_CIDADE,
    'CNPJ: ' ||
    CASE
        WHEN LENGTH(REGEXP_REPLACE(EMP.CGC, '[^0-9]', '')) = 14 THEN
            REGEXP_REPLACE(REGEXP_REPLACE(EMP.CGC, '[^0-9]', ''),
                '^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$', '\1.\2.\3/\4-\5')
        ELSE EMP.CGC
    END
    || '   IE: ' || EMP.INSCESTAD
    || '   Fone: ' || EMP.TELEFONE AS EMP_DOC
FROM AD_TGFASS ASS
    LEFT JOIN AD_CADFUNC FUN ON FUN.IDFUNC = ASS.TECNICO
    INNER JOIN TSIEMP EMP ON EMP.CODEMP = 1
    LEFT JOIN TSIEND EMPEDN ON EMPEDN.CODEND = EMP.CODEND
    LEFT JOIN TSIBAI EMPBAI ON EMPBAI.CODBAI = EMP.CODBAI
    LEFT JOIN TSICID EMPCID ON EMPCID.CODCID = EMP.CODCID
    LEFT JOIN TSIUFS EMPUFS ON EMPUFS.CODUF = EMPCID.UF
WHERE DECODE(ASS.MESFOLHA,
              NVL($P{P_MESFOLHA}, (SELECT REF.MESFOLHA FROM AD_TGFASS REF WHERE REF.NUMOS = $P{PK_NUMOS})),
              1, 0) = 1
  AND DECODE(ASS.STATUS, NVL($P{P_STATUS}, ASS.STATUS), 1, 0) = 1
GROUP BY ASS.TECNICO,
    ASS.STATUS,
    NVL(FUN.NOME, 'SEM TÉCNICO'),
    NVL(ASS.MESFOLHA, 'NÃO INFORMADO'),
    EMP.RAZAOSOCIAL,
    EMPEDN.NOMEEND, EMP.NUMEND, EMP.COMPLEMENTO, EMPBAI.NOMEBAI,
    EMPCID.NOMECID, EMPUFS.UF, EMP.CEP,
    EMP.CGC, EMP.INSCESTAD, EMP.TELEFONE
ORDER BY NVL(FUN.NOME, 'SEM TÉCNICO'), ASS.TECNICO, NVL(ASS.MESFOLHA, 'NÃO INFORMADO'), ASS.STATUS]]>
	</queryString>
	<field name="TECNICO" class="java.math.BigDecimal"/>
	<field name="NOMETECNICO" class="java.lang.String"/>
	<field name="MESFOLHA" class="java.lang.String"/>
	<field name="STATUS" class="java.lang.String"/>
	<field name="QTD_OS" class="java.math.BigDecimal"/>
	<field name="VLRSERVTECNICO" class="java.lang.Double"/>
	<field name="EMP_RAZAO" class="java.lang.String"/>
	<field name="EMP_ENDERECO" class="java.lang.String"/>
	<field name="EMP_CIDADE" class="java.lang.String"/>
	<field name="EMP_DOC" class="java.lang.String"/>
	<variable name="TOTAL_QTD_OS" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{QTD_OS}]]></variableExpression>
	</variable>
	<variable name="TOTAL_VLR" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRSERVTECNICO}]]></variableExpression>
	</variable>
