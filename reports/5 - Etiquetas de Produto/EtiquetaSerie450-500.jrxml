<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  Nome do Script : EtiquetaSerie450-500
  Tipo           : Relatório Jasper (.jrxml)
  Grupo          : 5 - Etiquetas de Produto
  Descrição      : Etiqueta de produto para faixa de tamanho 450-500mm com código de barras.

  Empresa        : Spark Eletrônica
  Autor          : Silvio Vieira
  Cargo          : Analista de Sistemas Sênior
  Data de Criação: [A DEFINIR]
  Última Revisão : Abril/2026 — Padronização de cabeçalho e comentários
  ==============================================================================
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EtiquetaSerie" language="groovy" columnCount="2" printOrder="Horizontal" pageWidth="303" pageHeight="42" orientation="Landscape" columnWidth="142" columnSpacing="8" leftMargin="8" rightMargin="2" topMargin="5" bottomMargin="1">
	<property name="ireport.zoom" value="4.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PK_IDIPROC" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[new BigDecimal(35)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT * FROM
(
SELECT IPA.IDIPROC,
       PRO.CODPROD,
       RPA.SERIEPA,
RANK()
	OVER (ORDER BY RPA.SERIEPA) AS RANQ
  FROM TPRIPROC OP INNER JOIN TPRIPA IPA ON (OP.IDIPROC = IPA.IDIPROC)
                   INNER JOIN TGFPRO PRO ON (PRO.CODPROD = IPA.CODPRODPA)
                   INNER JOIN AD_TPRSERPA RPA ON (OP.IDIPROC = RPA.IDIPROC AND RPA.CODPRODPA=IPA.CODPRODPA)
 WHERE OP.IDIPROC = $P{PK_IDIPROC}
 ) WHERE RANQ > 450
 AND RANQ <= 500]]>
	</queryString>
	<field name="IDIPROC" class="java.math.BigDecimal"/>
	<field name="CODPROD" class="java.math.BigDecimal"/>
	<field name="SERIEPA" class="java.lang.String"/>
	<field name="RANQ" class="java.math.BigDecimal"/>
	<detail>
		<band height="36" splitType="Stretch">
			<componentElement>
				<reportElement mode="Opaque" x="1" y="2" width="140" height="24"/>
				<jr:barbecue xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" type="Code128" drawText="false" checksumRequired="true" barWidth="20" barHeight="400">
					<jr:codeExpression><![CDATA[$F{SERIEPA}]]></jr:codeExpression>
				</jr:barbecue>
			</componentElement>
			<textField>
				<reportElement x="0" y="21" width="140" height="14"/>
				<textElement textAlignment="Center" verticalAlignment="Bottom">
					<font size="10" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{SERIEPA}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
