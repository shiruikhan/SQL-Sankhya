<gadget ><prompt-parameters><parameter  id="P_PERIODO" description="Período" metadata="datePeriod" required="true" keep-last="false" keep-date="false" order="0" label="P_PERIODO : Período"/><parameter  id="P_SETOR" description="Setor" metadata="multiList:Text" listType="text" required="false" keep-last="true" keep-date="false" order="1" label="P_SETOR : multiList:Text"><item value="S" label="Solda"/><item value="T" label="Teste"/><item value="I" label="Inserção"/><item value="TF" label="Transformador"/><item value="D" label="Display"/><item value="MF" label="Montagem Final"/><item value="C" label="Capacitor"/><item value="DP" label="Dissipador"/><item value="IN" label="Insersora"/></parameter></prompt-parameters><level id="lvl_gf2lrk" description="Principal"><container orientacao="V" tamanhoRelativo="100"><grid id="grd_gf2lrl" multiplaSelecao="S" useNewGrid="S"><expression type="sql" data-source="MGEDS"><![CDATA[SELECT APO.FUNCREVISOR2 || ' - ' || CAD.NOMEFUNC AS REVISOR,
	NVL(SUM(APO.MINSERIDO),0) AS MINSERIDO,
	NVL(SUM(APO.FALTANDO),0) AS FALTANDO,
	NVL(SUM(APO.INVERTIDO),0) AS INVERTIDO,
	NVL(SUM(APO.TROCADO),0) AS TROCADO,
	NVL(SUM(APO.QUEIMADO),0) AS QUEIMADO,
	NVL(SUM(APO.CURTO),0) AS CURTO,
	NVL(SUM(APO.SOLDAFRIA),0) AS SOLDAFRIA,
	NVL(SUM(APO.DEFEITOMP),0) AS DEFEITOMP,
	NVL(SUM(APO.CHICOTE),0) AS CHICOTE,
	NVL(SUM(APO.DISPLAY),0) AS DISPLAY,
	NVL(SUM(APO.AJUTENSAO),0) AS AJUTENSAO,
	NVL(SUM(APO.ACORRENTE),0) AS ACORRENTE,
	NVL(SUM(APO.LED),0) AS LED,
	NVL(SUM(APO.CONSUMO),0) AS CONSUMO,
	NVL(SUM(APO.CORRENTE),0) AS CORRENTE,
	NVL(SUM(APO.PROGRAMACAO),0) AS PROGRAMACAO,
	NVL(SUM(APO.OUTROSDEFEITOS),0) AS OUTROSDEFEITOS,
	NVL(SUM(APO.ADESIVOTROC),0) AS ADESIVOTROCADO,
	NVL(SUM(APO.ADESIVOTORT),0) AS ADESIVOTORTO,
	NVL(SUM(APO.GABARRANHADO),0) AS GABINETEARRANHADO,
	NVL(SUM(APO.GABAMASSADO),0) AS GABINETEAMASSADO,
	NVL(SUM(APO.TAMPATROCA),0) AS TAMPATROCADA,
	NVL(SUM(APO.TAMPAAMASS),0) AS TAMPAAMASSADA
FROM AD_APOQLD APO
	INNER JOIN TFPFUN CAD ON APO.FUNCREVISOR2 = CAD.CODFUNC
WHERE APO.DTAPO >= :P_PERIODO.INI
	AND APO.DTAPO <= :P_PERIODO.FIN
	AND APO.SETOR IN :P_SETOR
GROUP BY APO.FUNCREVISOR2 || ' - ' || CAD.NOMEFUNC]]></expression><metadata><field name="REVISOR" label="Revisor" type="S" visible="true" useFooter="false"></field><field name="MINSERIDO" label="Mal Inserido" type="I" visible="true" useFooter="SUM"></field><field name="FALTANDO" label="Faltando" type="I" visible="true" useFooter="SUM"></field><field name="INVERTIDO" label="Invertido" type="I" visible="true" useFooter="SUM"></field><field name="TROCADO" label="Trocado" type="I" visible="true" useFooter="SUM"></field><field name="QUEIMADO" label="Queimado" type="I" visible="true" useFooter="SUM"></field><field name="CURTO" label="Curto" type="I" visible="true" useFooter="SUM"></field><field name="SOLDAFRIA" label="Solda Fria" type="I" visible="true" useFooter="SUM"></field><field name="DEFEITOMP" label="Defeito de MP" type="I" visible="true" useFooter="SUM"></field><field name="CHICOTE" label="Chicote" type="I" visible="true" useFooter="SUM"></field><field name="DISPLAY" label="Display" type="I" visible="true" useFooter="SUM"></field><field name="AJUTENSAO" label="Ajuste de Tensão" type="I" visible="true" useFooter="SUM"></field><field name="ACORRENTE" label="Ajuste de Corrente" type="I" visible="true" useFooter="SUM"></field><field name="LED" label="LED" type="I" visible="true" useFooter="SUM"></field><field name="CONSUMO" label="Consumo" type="I" visible="true" useFooter="SUM"></field><field name="CORRENTE" label="Corrente Zerada" type="I" visible="true" useFooter="SUM"></field><field name="PROGRAMACAO" label="Não Programa" type="I" visible="true" useFooter="SUM"></field><field name="OUTROSDEFEITOS" label="Outros Defeitos" type="I" visible="true" useFooter="SUM"></field><field name="ADESIVOTROCADO" label="Adesivo Trocado" type="I" visible="true" useFooter="SUM"></field><field name="ADESIVOTORTO" label="Adesivo Torto" type="I" visible="true" useFooter="SUM"></field><field name="GABINETEARRANHADO" label="Gabinete Arranhado" type="I" visible="true" useFooter="SUM"></field><field name="GABINETEAMASSADO" label="Gabinete Amassado" type="I" visible="true" useFooter="SUM"></field><field name="TAMPATROCADA" label="Tampa Trocada" type="I" visible="true" useFooter="SUM"></field><field name="TAMPAAMASSADA" label="Tampa Amassada" type="I" visible="true" useFooter="SUM"></field><field name="TOTAL" label="Total" type="I" visible="true" useFooter="SUM"><calculated><formula><![CDATA[$ACORRENTE + $ADESIVOTORTO + $ADESIVOTROCADO + $AJUTENSAO + $CHICOTE + $CONSUMO + $CORRENTE + $CURTO + $DEFEITOMP + $DISPLAY + $FALTANDO + $GABINETEAMASSADO + $GABINETEARRANHADO + $INVERTIDO + $LED + $MINSERIDO + $OUTROSDEFEITOS + $PROGRAMACAO + $QUEIMADO + $SOLDAFRIA + $TAMPAAMASSADA + $TAMPATROCADA + $TROCADO]]></formula></calculated></field></metadata></grid></container></level></gadget>