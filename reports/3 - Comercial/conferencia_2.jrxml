				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="6"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{QTDCAIXA}]]></textFieldExpression>
			</textField>
			<line>
