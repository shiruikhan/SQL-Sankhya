	<field name="AD_BUYERADDRESS" class="java.lang.String"/>
	<field name="ENDERECO_PARCEIRO" class="java.lang.String"/>
	<field name="BAIRRO_PARCEIRO" class="java.lang.String"/>
	<field name="PAIS" class="java.lang.String"/>
	<field name="EMAIL_PARCEIRO" class="java.lang.String"/>
	<field name="TELEFONE_PARCEIRO" class="java.lang.String"/>
	<field name="PAIS_PARCEIRO" class="java.lang.String"/>
	<field name="RAZAOSOCIAL_DESTINATARIO" class="java.lang.String"/>
	<field name="ENDERECO_DESTINATARIO" class="java.lang.String"/>
	<field name="BAIRRO_DESTINATARIO" class="java.lang.String"/>
	<field name="PAIS_DESTINATARIO" class="java.lang.String"/>
	<field name="EMAIL_DESTINATARIO" class="java.lang.String"/>
	<field name="TELEFONE_DESTINTARIO" class="java.lang.String"/>
	<field name="PAIS_DESTINATARIO2" class="java.lang.String"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="NCM" class="java.lang.String"/>
	<field name="CODVOL" class="java.lang.String"/>
	<field name="TRANSPORTE" class="java.lang.String"/>
	<field name="LOCALENTREGA" class="java.lang.String"/>
	<field name="AD_INCOTERM" class="java.lang.String"/>
	<field name="NUMINVOICE" class="java.lang.String"/>
