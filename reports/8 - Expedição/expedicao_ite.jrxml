<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="expedicao_ite" language="groovy" pageWidth="523" pageHeight="802" columnWidth="523" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NUNOTA" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[SELECT
ITE.CODPROD,
PRO.DESCRPROD,
PRO.REFERENCIA,
ITE.QTDNEG,
PRO.PESOBRUTO,
PRO.PESOLIQ,
(ITE.QTDNEG * PRO.PESOBRUTO) AS PESOBRUTOTOT,
(ITE.QTDNEG * PRO.PESOLIQ) AS PESOLIQTOT
FROM
TGFITE ITE, TGFPRO PRO
WHERE
ITE.CODPROD = PRO.CODPROD
AND ITE.NUNOTA = $P{NUNOTA}]]>
	</queryString>
	<field name="CODPROD" class="java.math.BigDecimal"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="REFERENCIA" class="java.lang.String"/>
	<field name="QTDNEG" class="java.lang.Double"/>
	<field name="PESOBRUTO" class="java.lang.Double"/>
	<field name="PESOLIQ" class="java.lang.Double"/>
	<field name="PESOBRUTOTOT" class="java.math.BigDecimal"/>
	<field name="PESOLIQTOT" class="java.math.BigDecimal"/>
	<variable name="QTDNEG_1" class="java.lang.Double" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{QTDNEG}]]></variableExpression>
	</variable>
	<columnHeader>
		<band height="20">
			<staticText>
				<reportElement x="0" y="0" width="60" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Cód.]]></text>
			</staticText>
			<staticText>
				<reportElement x="60" y="0" width="210" height="20"/>
				<textElement verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Descrição]]></text>
			</staticText>
			<staticText>
				<reportElement x="270" y="0" width="110" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Referência]]></text>
			</staticText>
			<staticText>
				<reportElement x="380" y="0" width="70" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Peso]]></text>
			</staticText>
			<staticText>
				<reportElement x="450" y="0" width="73" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Quantidade]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="60" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{CODPROD}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="60" y="0" width="210" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{DESCRPROD}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="270" y="0" width="110" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{REFERENCIA}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="380" y="0" width="70" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{PESOBRUTOTOT}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true">
				<reportElement x="450" y="0" width="73" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{QTDNEG}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band height="20">
			<textField pattern="###0">
				<reportElement x="450" y="0" width="73" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Arial"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$V{QTDNEG_1}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="380" y="0" width="70" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Total:]]></text>
			</staticText>
		</band>
	</columnFooter>
</jasperReport>
