<gadget>
  <prompt-parameters>
    <parameter id="P_PERIODO" description="Período" metadata="datePeriod" required="true" keep-last="true" keep-date="false" order="0"/>
    <parameter id="P_CODPARC" description="Código do Parceiro" metadata="entity:Parceiro@CODPARC" required="false" keep-last="false" keep-date="false" order="2"/>
    <parameter id="P_CODPROD" description="Código do Produto" metadata="entity:Produto@CODPROD" required="false" keep-last="false" keep-date="false" order="3"/>
    <parameter id="P_CODNAT" description="Natureza" metadata="entity:Natureza@CODNAT" required="false" keep-last="false" keep-date="false" order="4"/>
  </prompt-parameters>
  <level id="lvl_au6b1zp" description="Principal">
    <container orientacao="V" tamanhoRelativo="100">
      <grid id="grd_au6b1zq" multiplaSelecao="S" useNewGrid="S">
        <expression type="sql" data-source="MGEDS"><![CDATA[SELECT CAB.NUNOTA, CAB.CODEMP, CAB.NUMNOTA, CAB.DTENTSAI, CAB.CODPARC, PAR.NOMEPARC, ITE.CODPROD, PRO.DESCRPROD, PRO.CODVOL, ITE.QTDNEG, ITE.VLRUNIT,(CASE WHEN ITE.AD_VLRCHEIO IS NULL THEN ITE.VLRUNIT ELSE ITE.AD_VLRCHEIO END) AS VLRCHEIO, USU.NOMEUSU AS INCLUSOR, NAT.DESCRNATFROM TGFITE ITEINNER JOIN TGFCAB CAB ON ITE.NUNOTA = CAB.NUNOTAINNER JOIN TGFPAR PAR ON CAB.CODPARC = PAR.CODPARCINNER JOIN TGFPRO PRO ON ITE.CODPROD = PRO.CODPRODINNER JOIN TSIUSU USU ON CAB.CODUSUINC = USU.CODUSUINNER JOIN TGFNAT NAT ON CAB.CODNAT = NAT.CODNATWHERE (CAB.CODPARC = :P_CODPARC OR :P_CODPARC IS NULL) AND (ITE.CODPROD = :P_CODPROD OR :P_CODPROD IS NULL) AND (CAB.DTENTSAI >= :P_PERIODO.INI AND CAB.DTENTSAI <= :P_PERIODO.FIN) AND (CAB.TIPMOV = 'V') AND CAB.STATUSNOTA = 'L'ORDER BY CAB.DTENTSAI, CAB.NUNOTA]]></expression>
        <metadata>
          <field name="NUNOTA" label="Nr Único" type="I" visible="true" useFooter="false"/>
          <field name="CODEMP" label="Empresa" type="I" visible="true" useFooter="false"/>
          <field name="NUMNOTA" label="Nr Nota" type="I" visible="true" useFooter="false"/>
          <field name="DTENTSAI" label="Dt Entrada/Saída" type="D" visible="true" useFooter="false"/>
          <field name="CODPARC" label="Cod Parceiro" type="I" visible="true" useFooter="false"/>
          <field name="NOMEPARC" label="Nome Parceiro" type="S" visible="true" useFooter="false"/>
          <field name="CODPROD" label="Cod" type="I" visible="true" useFooter="false"/>
          <field name="DESCRPROD" label="Descrição" type="S" visible="true" useFooter="false"/>
          <field name="CODVOL" label="*" type="S" visible="true" useFooter="false"/>
          <field name="QTDNEG" label="Qtd" type="F" visible="true" useFooter="SUM"/>
          <field name="VLRUNIT" label="Vlr Unit" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="VLRCHEIO" label="Vlr Cheio" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="INCLUSOR" label="Usuário Criador" type="S" visible="true" useFooter="false"/>
          <field name="DESCRNAT" label="Natureza" type="S" visible="true" useFooter="false"/>
        </metadata>
        <on-click-launcher resource-id="br.com.sankhya.mgecom.mov.selecaodedocumento">
          <NUNOTA>$NUNOTA</NUNOTA>
        </on-click-launcher>
      </grid>
    </container>
  </level>
</gadget>