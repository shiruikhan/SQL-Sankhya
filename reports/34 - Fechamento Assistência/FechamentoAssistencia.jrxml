				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{NUFIN} == null ? "" : String.valueOf($F{NUFIN})]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
