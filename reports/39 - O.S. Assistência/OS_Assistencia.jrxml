	<property name="ireport.definition"/>
	<subDataset name="Table Dataset 1"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="NUMOSINI" class="java.math.BigDecimal">
		<parameterDescription><![CDATA[Nr. OS Final]]></parameterDescription>
	</parameter>
	<parameter name="NUMOSFIN" class="java.math.BigDecimal">
		<parameterDescription><![CDATA[Nr. OS Final]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT ASS.CODPARCASS || ' - ' || (SELECT P.NOMEPARC FROM TGFPAR P WHERE P.CODPARC = ASS.CODPARCASS) AS "ASSISTENCIA RESPONSAVEL",
	ASS.DTRECEB AS "DATA DE RECEBIMENTO",
	ASS.NUMOS AS "NR DA OS",
	ASS.CODPARC || ' - ' || PAR.NOMEPARC AS CLIENTE,
	EN.NOMEEND AS RUA,
	PAR.NUMEND AS "NR DA RESIDENCIA",
	CID.NOMECID AS CIDADE,
	UFS.UF AS ESTADO,
	PAR.TELEFONE,
	ASS.SNENTRADA AS "SN DO PRODUTO",
	(SELECT DISTINCT RFINTERNA FROM VGFSERIES WHERE VGFSERIES.SERIE = ASS.SNENTRADA AND MOVIMENTO = 'ENTRADA') AS "REFERENCIA INTERNA",
	(SELECT DISTINCT DESCRPARVENDA FROM VGFSERIES WHERE VGFSERIES.SERIE = ASS.SNENTRADA AND VGFSERIES.MOVIMENTO = 'SAÍDA' AND VGFSERIES.DTVENDA = (SELECT MAX(DTVENDA) FROM VGFSERIES WHERE VGFSERIES.SERIE = ASS.SNENTRADA AND VGFSERIES.MOVIMENTO = 'SAÍDA')) AS REVENDEDOR,
	ASS.NUMNOTAENT AS "NOTA DE ENTRADA",
	(CASE WHEN ASS.STATUS = 'G' THEN 'GARANTIA'
		WHEN ASS.STATUS = 'RN' THEN 'RENOVAÇÃO'
		WHEN ASS.STATUS = 'D' THEN 'DEVOLUÇÃO'
		WHEN ASS.STATUS = 'T' THEN 'TROCA'
		WHEN ASS.STATUS = 'RT' THEN 'RETORNO/TROCA'
		WHEN ASS.STATUS = 'R' THEN 'RETORNO'
		WHEN ASS.STATUS = 'TG' THEN 'TROCA DE GERAÇÃO' END) AS STATUS,
	ASS.T_DTVENDA AS "DATA DE COMPRA",
	ASS.DTENVIO AS "DATA DE ENTREGA",
	NVL((SELECT MAX(OPC.OPCAO)
	       FROM TDDOPC OPC
	      INNER JOIN TDDCAM CAM ON CAM.NUCAMPO = OPC.NUCAMPO
	      WHERE CAM.NOMETAB   = 'AD_TGFASS'
	        AND CAM.NOMECAMPO = 'DEFEITO'
	        AND OPC.VALOR     = ASS.DEFEITO), ASS.DEFEITO) AS "DEFEITO APRESENTADO",
	TEC.NOME AS TECNICO,
	SOL.NOME || CASE WHEN SOL.NOME IS NOT NULL AND SOL2.NOME IS NOT NULL THEN ' / ' END || SOL2.NOME AS SOLDA,
	TES.NOME AS TESTE,
	INS.NOME AS INSERCAO,
	ASS.VERSAO AS "VERSAO DE PLACA",
	CASE WHEN NVL(ASS.DISJUNTOR, 'N')     <> 'N' THEN 'X' END AS DP_DISJUNTOR,
	CASE WHEN NVL(ASS.LED, 'N')           <> 'N' THEN 'X' END AS DP_LED,
	CASE WHEN NVL(ASS.COOLER, 'N')        <> 'N' THEN 'X' END AS DP_COOLER,
	CASE WHEN NVL(ASS.SOLDA, 'N')         <> 'N' THEN 'X' END AS DP_SOLDA,
	CASE WHEN NVL(ASS.INDUTOR, 'N')       <> 'N' THEN 'X' END AS DP_INDUTOR,
	CASE WHEN NVL(ASS.MICA, 'N')          <> 'N' THEN 'X' END AS DP_MICA,
	CASE WHEN NVL(ASS.CORRENTEMIN, 'N')   <> 'N' THEN 'X' END AS DP_CORRENTEMIN,
	CASE WHEN NVL(ASS.CORRENTEMAX, 'N')   <> 'N' THEN 'X' END AS DP_CORRENTEMAX,
	CASE WHEN NVL(ASS.DISPLAY, 'N')       <> 'N' THEN 'X' END AS DP_DISPLAY,
	CASE WHEN NVL(ASS.ADESIVO, 'N')       <> 'N' THEN 'X' END AS DP_ADESIVO,
	CASE WHEN NVL(ASS.CURTO, 'N')         <> 'N' THEN 'X' END AS DP_CURTO,
	CASE WHEN NVL(ASS.COMPINVERTIDO, 'N') <> 'N' THEN 'X' END AS DP_COMPINVERTIDO,
	CASE WHEN NVL(ASS.CHICOTE, 'N')       <> 'N' THEN 'X' END AS DP_CHICOTE,
	CASE WHEN NVL(ASS.TRANSFORMADOR, 'N') <> 'N' THEN 'X' END AS DP_TRANSFORMADOR
FROM AD_TGFASS ASS
	LEFT JOIN TGFPAR PAR ON ASS.CODPARC = PAR.CODPARC
	LEFT JOIN TSIEND EN  ON PAR.CODEND = EN.CODEND
	LEFT JOIN TSICID CID ON PAR.CODCID = CID.CODCID
	LEFT JOIN TSIUFS UFS ON CID.UF = UFS.CODUF
	LEFT JOIN AD_CADFUNC TEC  ON TEC.IDFUNC  = ASS.TECNICO
	LEFT JOIN AD_CADFUNC SOL  ON SOL.IDFUNC  = ASS.FUNCSOLDA
	LEFT JOIN AD_CADFUNC SOL2 ON SOL2.IDFUNC = ASS.FUNCSOLDA2
	LEFT JOIN AD_CADFUNC TES  ON TES.IDFUNC  = ASS.FUNCTESTE
	LEFT JOIN AD_CADFUNC INS  ON INS.IDFUNC  = ASS.FUNCINSERCAO
WHERE ASS.NUMOS >= $P{NUMOSINI}
	AND ASS.NUMOS <= $P{NUMOSFIN}]]>
	</queryString>
