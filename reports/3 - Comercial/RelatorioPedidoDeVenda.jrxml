	<field name="VLRUNITARIO" class="java.lang.Double"/>
	<field name="PERCDESCONTO" class="java.lang.Double"/>
	<field name="PERCIPI" class="java.math.BigDecimal"/>
	<field name="VLRIPI" class="java.math.BigDecimal"/>
	<field name="VLRST" class="java.math.BigDecimal"/>
	<field name="PRECOFINAL" class="java.math.BigDecimal"/>
	<field name="TOTALITENS" class="java.math.BigDecimal"/>
	<field name="TOTALBRUTO" class="java.math.BigDecimal"/>
	<field name="TOTSERV" class="java.math.BigDecimal"/>
	<field name="TOTPROD" class="java.math.BigDecimal"/>
	<field name="TOTITEIPIST" class="java.math.BigDecimal"/>
	<field name="VLRTOTALST" class="java.math.BigDecimal"/>
	<field name="VLRTOTALIPI" class="java.math.BigDecimal"/>
	<field name="DESCONTOTOTAL" class="java.math.BigDecimal"/>
	<field name="FRETE" class="java.math.BigDecimal"/>
	<field name="PERCFRETE" class="java.math.BigDecimal"/>
	<field name="TOTALLIQUIDO" class="java.math.BigDecimal"/>
	<field name="NOMETRANSPORTADORA" class="java.lang.String"/>
	<field name="OBSERVACAO" class="java.lang.String"/>
	<field name="USUARIO" class="java.lang.String"/>
	<field name="CODVEND" class="java.math.BigDecimal"/>
