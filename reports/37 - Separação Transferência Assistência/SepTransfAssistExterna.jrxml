					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA["Local " + $F{CODLOCALDEST} + ($F{DESCRLOCALDEST} == null ? "" : " - " + $F{DESCRLOCALDEST})]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="6" y="50" width="62" height="14"/>
