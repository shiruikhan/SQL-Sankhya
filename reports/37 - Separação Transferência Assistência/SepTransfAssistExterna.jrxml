<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  Nome do Script : SepTransfAssistExterna
  Tipo           : Relatório Jasper (.jrxml)
  Grupo          : 37 - Separação Transferência Assistência
  Descrição      : Lista de separação física das transferências de reposição da
                   assistência externa geradas por STP_MOVMATASSIST_SPARK (TOP
                   708, local 201 -> local do parceiro). O usuário usa a lista
                   para separar os componentes antes de enviá-los ao local do
                   parceiro.
                   Os itens são lidos da própria nota de transferência (TGFITE,
                   itens de saída, SEQUENCIA > 0) e UNIFICADOS POR PARCEIRO:
                   uma seção (página nova) por parceiro, com uma linha por
                   produto + unidade (CODPROD | DESCRPROD | CODVOL | QTD), com
                   a quantidade somada de todas as O.S. concluídas no período
                   (filtro por AD_SPKCAE.DTCONCLUSAO).
                   Cabeçalho padrão com os dados da empresa 1 (Spark Eletrônica
                   — TSIEMP) e logo.

  Parâmetros     : P_CODPARC — parceiro da assistência externa (opcional). Em
                               branco, uma seção para cada parceiro.
                   P_DTINI   — data inicial de conclusão da O.S. (DTCONCLUSAO;
                               opcional; padrão = hoje)
                   P_DTFIN   — data final de conclusão da O.S. (DTCONCLUSAO;
                               opcional; padrão = hoje)

  Tabelas        : AD_SPKCAE : O.S. de conserto externo (NUNOTATRF, CODPARC)
                   TGFCAB / TGFITE : nota de transferência e seus itens
                   TGFPRO / TGFPAR / TGFLOC : descrição do produto, parceiro
                                   (AD_CODLOCAL) e locais
                   TSIEMP / TSIEND / TSIBAI / TSICID / TSIUFS : dados da empresa 1

  Empresa        : Spark Eletrônica
  Autor          : Silvio Vieira
  Cargo          : Analista de Sistemas Sênior
  Data de Criação: 30/09/2026
  Última Revisão : Setembro/2026 — Criação

  Observações    : - O relatório NÃO usa PK_ da tela: lista por período/parceiro
                     (parâmetros acima). Se for chamado de uma tela com N
                     registros selecionados, o Sankhya executa o relatório N
                     vezes com os mesmos parâmetros e sai o mesmo conteúdo N
                     vezes — imprimir com um único registro selecionado.
                   - O período filtra AD_SPKCAE.DTCONCLUSAO (data de conclusão da
                     O.S.). O.S. sem DTCONCLUSAO não entram quando há data
                     informada. Limpar as datas lista todo o histórico —
                     cuidado ao reimprimir.
                   - Só entram O.S. com NUNOTATRF preenchido e TOP 708.
                   - O local de origem exibido vem do próprio item da nota
                     (TGFITE.CODLOCALORIG); o de destino, de TGFPAR.AD_CODLOCAL.
                   - Itens iguais (mesmo produto e unidade) de O.S. diferentes do
                     mesmo parceiro são somados numa única linha.
  ==============================================================================
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SepTransfAssistExterna" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoDataSection">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="P_CODPARC" class="java.math.BigDecimal">
		<property name="NOMETABELA" value="TGFPAR"/>
		<parameterDescription><![CDATA[Parceiro da assistência externa (opcional; em branco lista todos)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DTINI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data inicial de conclusão da O.S. (opcional)]]></parameterDescription>
		<defaultValueExpression><![CDATA[new java.sql.Timestamp(System.currentTimeMillis())]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DTFIN" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data final de conclusão da O.S. (opcional)]]></parameterDescription>
		<defaultValueExpression><![CDATA[new java.sql.Timestamp(System.currentTimeMillis())]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT X.CODPARC,
    X.NOMEPARC,
    X.CODLOCALORIG,
    X.DESCRLOCALORIG,
    X.CODLOCALDEST,
    X.DESCRLOCALDEST,
    X.CODPROD,
    X.DESCRPROD,
    X.CODVOL,
    X.QTD,
    EMP.RAZAOSOCIAL AS EMP_RAZAO,
    EMPEDN.NOMEEND || ', ' || EMP.NUMEND
        || CASE WHEN EMP.COMPLEMENTO IS NOT NULL THEN ' - ' || EMP.COMPLEMENTO END
        || CASE WHEN EMPBAI.NOMEBAI IS NOT NULL THEN ' - ' || EMPBAI.NOMEBAI END AS EMP_ENDERECO,
    EMPCID.NOMECID || '/' || EMPUFS.UF || ' - CEP ' || EMP.CEP AS EMP_CIDADE,
    'CNPJ: ' ||
    CASE
        WHEN LENGTH(REGEXP_REPLACE(EMP.CGC, '[^0-9]', '')) = 14 THEN
            REGEXP_REPLACE(REGEXP_REPLACE(EMP.CGC, '[^0-9]', ''),
                '^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$', '\1.\2.\3/\4-\5')
        ELSE EMP.CGC
    END
    || '   IE: ' || EMP.INSCESTAD
    || '   Fone: ' || EMP.TELEFONE AS EMP_DOC
FROM (
    SELECT CAE.CODPARC,
        PAR.NOMEPARC,
        ITE.CODLOCALORIG,
        LOR.DESCRLOCAL AS DESCRLOCALORIG,
        PAR.AD_CODLOCAL AS CODLOCALDEST,
        LDE.DESCRLOCAL AS DESCRLOCALDEST,
        ITE.CODPROD,
        PRO.DESCRPROD,
        ITE.CODVOL,
        SUM(ITE.QTDNEG) AS QTD
    FROM AD_SPKCAE CAE
        INNER JOIN TGFCAB CAB ON CAB.NUNOTA = CAE.NUNOTATRF
        INNER JOIN TGFITE ITE ON ITE.NUNOTA = CAB.NUNOTA
        INNER JOIN TGFPRO PRO ON PRO.CODPROD = ITE.CODPROD
        INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAE.CODPARC
        LEFT JOIN TGFLOC LOR ON LOR.CODLOCAL = ITE.CODLOCALORIG
        LEFT JOIN TGFLOC LDE ON LDE.CODLOCAL = PAR.AD_CODLOCAL
    WHERE CAB.CODTIPOPER = 708
      AND ITE.SEQUENCIA > 0
      AND DECODE(CAE.CODPARC, NVL($P{P_CODPARC}, CAE.CODPARC), 1, 0) = 1
      AND CAE.DTCONCLUSAO >= TRUNC(NVL($P{P_DTINI}, CAE.DTCONCLUSAO))
      AND CAE.DTCONCLUSAO < TRUNC(NVL($P{P_DTFIN}, CAE.DTCONCLUSAO)) + 1
    GROUP BY CAE.CODPARC,
        PAR.NOMEPARC,
        ITE.CODLOCALORIG,
        LOR.DESCRLOCAL,
        PAR.AD_CODLOCAL,
        LDE.DESCRLOCAL,
        ITE.CODPROD,
        PRO.DESCRPROD,
        ITE.CODVOL
) X
    INNER JOIN TSIEMP EMP ON EMP.CODEMP = 1
    LEFT JOIN TSIEND EMPEDN ON EMPEDN.CODEND = EMP.CODEND
    LEFT JOIN TSIBAI EMPBAI ON EMPBAI.CODBAI = EMP.CODBAI
    LEFT JOIN TSICID EMPCID ON EMPCID.CODCID = EMP.CODCID
    LEFT JOIN TSIUFS EMPUFS ON EMPUFS.CODUF = EMPCID.UF
ORDER BY X.NOMEPARC, X.CODPARC, X.CODPROD, X.CODVOL]]>
	</queryString>
	<field name="CODPARC" class="java.math.BigDecimal"/>
	<field name="NOMEPARC" class="java.lang.String"/>
	<field name="CODLOCALORIG" class="java.math.BigDecimal"/>
	<field name="DESCRLOCALORIG" class="java.lang.String"/>
	<field name="CODLOCALDEST" class="java.math.BigDecimal"/>
	<field name="DESCRLOCALDEST" class="java.lang.String"/>
	<field name="CODPROD" class="java.math.BigDecimal"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="CODVOL" class="java.lang.String"/>
	<field name="QTD" class="java.lang.Double"/>
	<field name="EMP_RAZAO" class="java.lang.String"/>
	<field name="EMP_ENDERECO" class="java.lang.String"/>
	<field name="EMP_CIDADE" class="java.lang.String"/>
	<field name="EMP_DOC" class="java.lang.String"/>
	<variable name="QTD_ITENS" class="java.lang.Integer" resetType="Group" resetGroup="CODPARC" calculation="Count">
		<variableExpression><![CDATA[$F{CODPROD}]]></variableExpression>
	</variable>
