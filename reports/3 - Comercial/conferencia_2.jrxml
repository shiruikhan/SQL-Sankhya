				</graphicElement>
			</line>
			<line>
				<reportElement x="554" y="-1" width="1" height="22"/>
			</line>
			<line>
				<reportElement x="554" y="-21" width="1" height="21"/>
			</line>
			<line>
				<reportElement x="0" y="0" width="1" height="20"/>
			</line>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="396" y="1" width="79" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="6"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{PESOTOTCAIXA}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00">
				<reportElement x="475" y="1" width="79" height="20"/>
