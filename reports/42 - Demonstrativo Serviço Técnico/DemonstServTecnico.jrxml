<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  Nome do Script : DemonstServTecnico
  Tipo           : Relatório Jasper (.jrxml)
  Grupo          : 42 - Demonstrativo Serviço Técnico
  Descrição      : Demonstrativo individual dos serviços do técnico da
                   assistência interna, entregue ao RH para inclusão do valor
                   em folha de pagamento. Um documento por técnico (quebra de
                   página e numeração reiniciada a cada técnico), listando
                   cada O.S. concluída com o VLRSERVTECNICO, total do técnico,
                   declaração de conferência com quantidade e valor total e
                   linha de assinatura do funcionário.
                   Sem logo nem dados da empresa: o documento não identifica
                   a empresa.

  Parâmetros     : PK_NUMOS   — NUMOS do lançamento selecionado na tela de O.S.
                                (AD_TGFASS). Injetado pelo Sankhya; opcional.
                   P_TECNICO  — (opcional) técnico (AD_CADFUNC.IDFUNC). Em
                                branco, emite um documento para cada técnico.
                   P_MESFOLHA — (opcional) mês da folha (AD_TGFASS.MESFOLHA).
                   P_DTINI    — (opcional) data de conclusão inicial.
                   P_DTFIN    — (opcional) data de conclusão final, inclusiva.
                   Período e mês da folha podem ser usados juntos (E) ou
                   separados. Sem nenhum dos dois, assume o MESFOLHA do
                   lançamento selecionado (PK_NUMOS).

  Tabelas        : AD_TGFASS     : O.S. de assistência (leitura)
                   AD_CADFUNC    : nome do técnico
                   TDDCAM/TDDOPC : texto da opção de STATUS

  Empresa        : Spark Eletrônica
  Autor          : Silvio Vieira
  Cargo          : Analista de Sistemas Sênior
  Data de Criação: 04/11/2026
  Última Revisão : Novembro/2026 — Expressões em Java puro (o Sankhya compila
                   como Java); moeda via NumberFormat pt-BR
                   Novembro/2026 — Removidos logo e dados da empresa; colunas
                   redistribuídas (fonte 7) para Produto/Série; rótulo
                   "TOTAL"; novo texto de declaração; removido o descritivo
                   sob a linha de assinatura

  Observações    : - Só entram O.S. concluídas (DTCONCLUSAO preenchida) e com
                     técnico informado.
                   - Valores formatados em pt-BR (R$ 1.234,56); negativos
                     (ex.: Retorno Técnico, -20) saem como -R$ 20,00 e abatem
                     o total.
                   - Expressões escritas em Java puro: o Sankhya compila como
                     Java mesmo com language="groovy".
                   - O Sankhya não repassa a seleção múltipla: com vários
                     lançamentos selecionados o relatório roda uma vez por
                     registro. Para o RH, imprimir com UM lançamento
                     selecionado ou informar os filtros.
  ==============================================================================
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DemonstServTecnico" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoDataSection">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PK_NUMOS" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[Nr. OS]]></parameterDescription>
	</parameter>
	<parameter name="P_TECNICO" class="java.math.BigDecimal">
		<property name="NOMETABELA" value="AD_CADFUNC"/>
		<parameterDescription><![CDATA[Técnico (opcional; em branco emite um documento por técnico)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_MESFOLHA" class="java.lang.String">
		<parameterDescription><![CDATA[Mês da folha (opcional)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DTINI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data de conclusão inicial (opcional)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DTFIN" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data de conclusão final (opcional)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH FILTRO AS (
    SELECT NVL($P{P_MESFOLHA},
               CASE
                   WHEN $P{P_DTINI} IS NULL AND $P{P_DTFIN} IS NULL
                       THEN (SELECT REF.MESFOLHA FROM AD_TGFASS REF WHERE REF.NUMOS = $P{PK_NUMOS})
               END) AS MESFOLHA
      FROM DUAL
)
SELECT ASS.TECNICO,
    FUN.NOME AS NOMETECNICO,
    ASS.NUMOS,
    ASS.DTCONCLUSAO,
    NVL((SELECT MAX(OPC.OPCAO)
           FROM TDDOPC OPC
          INNER JOIN TDDCAM CAM ON CAM.NUCAMPO = OPC.NUCAMPO
          WHERE CAM.NOMETAB   = 'AD_TGFASS'
            AND CAM.NOMECAMPO = 'STATUS'
            AND OPC.VALOR     = ASS.STATUS), ASS.STATUS) AS STATUS,
    ASS.T_CODPROD || CASE WHEN ASS.T_DESCRPROD IS NOT NULL THEN ' - ' || ASS.T_DESCRPROD END AS PRODUTO,
    ASS.SNENTRADA,
    ASS.MESFOLHA,
    NVL(ASS.VLRSERVTECNICO, 0) AS VLRSERVTECNICO,
    TRIM(
        CASE WHEN FIL.MESFOLHA IS NOT NULL THEN 'Mês da folha: ' || FIL.MESFOLHA || '     ' END
     || CASE WHEN $P{P_DTINI} IS NOT NULL OR $P{P_DTFIN} IS NOT NULL
             THEN 'Período de conclusão: '
               || NVL(TO_CHAR($P{P_DTINI}, 'DD/MM/YYYY'), '...') || ' a '
               || NVL(TO_CHAR($P{P_DTFIN}, 'DD/MM/YYYY'), '...')
        END) AS REFERENCIA
FROM AD_TGFASS ASS
    CROSS JOIN FILTRO FIL
    INNER JOIN AD_CADFUNC FUN ON FUN.IDFUNC = ASS.TECNICO
WHERE ASS.DTCONCLUSAO IS NOT NULL
  AND ($P{P_TECNICO} IS NULL OR ASS.TECNICO = $P{P_TECNICO})
  AND (FIL.MESFOLHA IS NULL OR ASS.MESFOLHA = FIL.MESFOLHA)
  AND ($P{P_DTINI} IS NULL OR ASS.DTCONCLUSAO >= TRUNC($P{P_DTINI}))
  AND ($P{P_DTFIN} IS NULL OR ASS.DTCONCLUSAO <  TRUNC($P{P_DTFIN}) + 1)
ORDER BY FUN.NOME, ASS.TECNICO, ASS.DTCONCLUSAO, ASS.NUMOS]]>
	</queryString>
	<field name="TECNICO" class="java.math.BigDecimal"/>
	<field name="NOMETECNICO" class="java.lang.String"/>
	<field name="NUMOS" class="java.math.BigDecimal"/>
	<field name="DTCONCLUSAO" class="java.sql.Timestamp"/>
	<field name="STATUS" class="java.lang.String"/>
	<field name="PRODUTO" class="java.lang.String"/>
	<field name="SNENTRADA" class="java.lang.String"/>
	<field name="MESFOLHA" class="java.lang.String"/>
	<field name="VLRSERVTECNICO" class="java.lang.Double"/>
	<field name="REFERENCIA" class="java.lang.String"/>
	<variable name="VLR_TECNICO" class="java.lang.Double" resetType="Group" resetGroup="TECNICO" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRSERVTECNICO}]]></variableExpression>
	</variable>
	<variable name="QTD_TECNICO" class="java.lang.Integer" resetType="Group" resetGroup="TECNICO" calculation="Count">
		<variableExpression><![CDATA[$F{NUMOS}]]></variableExpression>
	</variable>
