	<field name="DTFATUR" class="java.sql.Timestamp"/>
	<variable name="VLRTOT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRTOT}]]></variableExpression>
	</variable>
	<variable name="PESOTOT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOTOT}]]></variableExpression>
	</variable>
