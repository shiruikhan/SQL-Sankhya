	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="PK2_IDIPROC" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PK_IDIATV" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
	ATV.IDEFX
	,MP.CODPRODMP
	,MP.QTDMISTURA
	,MP.CODVOL
	,EFX.DESCRICAO
	,PROC.IDIPROC
	,IPA.CODPRODPA
	,PRO.DESCRPROD
	,IPA.QTDPRODUZIR * MP.QTDMISTURA AS TOTAL
	,cast(LPA.AD_OBSTECNICA as varchar2(3999)) AS OBSTECNICA
	,AD_POSINSERCAO
FROM TPRIPROC PROC
	INNER JOIN TPRPRC PRC ON PRC.IDPROC = PROC.IDPROC
	INNER JOIN TPRLPA LPA ON LPA.IDPROC = PRC.IDPROC
	INNER JOIN TPRATV ATV ON PRC.IDPROC = ATV.IDPROC
	INNER JOIN TPRIPA IPA ON (IPA.IDIPROC = PROC.IDIPROC AND IPA.CODPRODPA = LPA.CODPRODPA)
	INNER JOIN TPROEST EST ON (EST.IDEFX = ATV.IDEFX)
	INNER JOIN TPRLMP MP ON (ATV.IDEFX = MP.IDEFX AND IPA.CODPRODPA = MP.CODPRODPA)
	INNER JOIN TPREFX EFX ON EFX.IDEFX = ATV.IDEFX
	INNER JOIN TGFPRO PRO ON PRO.CODPROD = MP.CODPRODMP
WHERE PROC.IDIPROC= $P{PK2_IDIPROC}
ORDER BY 1,2,6]]>
	</queryString>
	<field name="IDEFX" class="java.math.BigDecimal"/>
	<field name="CODPRODMP" class="java.math.BigDecimal"/>
	<field name="QTDMISTURA" class="java.math.BigDecimal"/>
	<field name="CODVOL" class="java.lang.String"/>
	<field name="DESCRICAO" class="java.lang.String"/>
	<field name="IDIPROC" class="java.math.BigDecimal"/>
	<field name="CODPRODPA" class="java.math.BigDecimal"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<field name="OBSTECNICA" class="java.lang.String"/>
	<field name="AD_POSINSERCAO" class="java.math.BigDecimal"/>
	<variable name="LOTE_1" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
