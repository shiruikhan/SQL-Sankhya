  Última Revisão : Abril/2026 — Padronização de cabeçalho e comentários
  ==============================================================================
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="INVOICE" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="2.415765000000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="302"/>
	<property name="ireport.definition"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\CLIENTES\\SPARK\\112 -\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT CAB.NUNOTA
, CAB.NUMNOTA
, CAB.OBSERVACAO
, EMP.RAZAOSOCIAL AS RAZAOEMP
, 'CNPJ: ' || Formatar_Cpf_Cnpj(EMP.CGC) AS CGC_EMP
, 'STREET' || ' ' || ENC.NOMEEND||', ' || EMP.NUMEND || ' - ' || BAIE.NOMEBAI AS ENDERECO_EMP
, CIDE.NOMECID||', ' || UFSE.DESCRICAO || ' - ' || 'BRAZIL ' || EMP.CEP AS CIDADE_EMP
, 'PHONE: +55' || EMP.TELEFONE AS TELEFONE_EMP
, 'E-MAIL: pedidos@usinaspark.com.br' AS EMAIL_EMP
, CAB.CODVEND
, VEN.APELIDO
, CAB.CODPARC
, PAR.NOMEPARC
, PAR.RAZAOSOCIAL
, PAR.TELEFONE
, PAR.FAX
, Formatar_Cpf_Cnpj(PAR.CGC_CPF) AS CGC_CPF
, PAR.CEP
, PAR.INSCESTADNAUF
, ENDE.TIPO || ' ' || ENDE.NOMEEND||', ' || PAR.NUMEND AS ENDERECO_PARCEIRO
, BAI.NOMEBAI || ' ' || PAR.COMPLEMENTO AS BAIRRO_PARCEIRO
, CID.NOMECID ||' / ' ||PAI.DESCRICAO AS PAIS
, 'E-mail: ' || PAR.EMAIL AS EMAIL_PARCEIRO
, 'Phone: ' || PAR.TELEFONE as TELEFONE_PARCEIRO
, PAI.DESCRICAO AS PAIS_PARCEIRO
, (SELECT SUM(PRO.PESOBRUTO * ITE.QTDNEG) FROM TGFITE ITE, TGFPRO PRO WHERE ITE.CODPROD = PRO.CODPROD AND ITE.NUNOTA = CAB.NUNOTA) AS PESOTOT,
CAB.DTFATUR,
SUBSTR(AD_NRINVOICE,0,(length(to_char(AD_NRINVOICE)))-4) || '/' || SUBSTR(AD_NRINVOICE,-4,4) AS NUMINVOICE,
(SELECT OPCAO FROM TDDOPC WHERE NUCAMPO = 9999990602 AND VALOR = CAB.AD_TRANSPORTE) AS TRANSPORTE,

(SELECT SUM(PESOTOTAL)
FROM
(
SELECT
    (PRO.PESOBRUTO * COUNT(DISTINCT IDCAIXA)) + SUM(V.PESOBRUTO) AS PESOTOTAL
FROM AD_EMBPED V, TGFPRO PRO, TGFPRO PROD
WHERE V.CODPRODEMB = PRO.CODPROD
   AND V.CODPROD = PROD.CODPROD
   AND V.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})
GROUP BY PRO.CODPROD , PRO.DESCRPROD, PRO.M3, PRO.PESOBRUTO
) V
) AS PESOTOTAL

FROM TGFCAB CAB
, TGFPAR PAR
, TSIEND ENDE
, TSIUFS UFS
, TSICID CID
, TSIPAI PAI
, TSIBAI BAI
, TGFVEI VEI
, TSIEMP EMP
, TSIEND ENC
, TSIBAI BAIE
, TSICID CIDE
, TSIUFS UFSE
, TGFVEN VEN
WHERE CAB.CODPARC = PAR.CODPARC
AND PAR.CODEND = ENDE.CODEND
AND PAR.CODCID = CID.CODCID
AND CID.UF = UFS.CODUF
AND UFS.CODPAIS = PAI.CODPAIS
AND PAR.CODBAI= BAI.CODBAI
AND CAB.CODVEICULO = VEI.CODVEICULO
AND CAB.CODEMP = EMP.CODEMP
AND EMP.CODEND = ENC.CODEND
AND EMP.CODBAI = BAIE.CODBAI
AND EMP.CODCID = CIDE.CODCID
AND CIDE.UF = UFSE.CODUF
AND VEN.CODVEND = CAB.CODVEND
AND CAB.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})
ORDER BY CAB.DTNEG, CAB.NUNOTA, CAB.CODEMP]]>
	</queryString>
