<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ETIQUETA_EMB_SUB" language="groovy" pageWidth="283" pageHeight="425" columnWidth="283" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT CAB.NUNOTA, CAB.NUMNOTA, EMP.RAZAOSOCIAL, PAR.RAZAOSOCIAL AS RAZAOPARC, PART.RAZAOSOCIAL AS TRANSP, CAB.QTDVOL AS QTDCAIXA, ROWNUM AS QTDUNIT
 FROM TGFCAB CAB, TSIEMP EMP, TGFPAR PAR, TGFPRO PRO, TGFPAR PART
WHERE CAB.CODPARC= PAR.CODPARC
 AND CAB.CODEMP = EMP.CODEMP
 AND CAB.CODPARCTRANSP = PART.CODPARC
 AND CAB.NUNOTA = $P{PK_NUNOTA}
 AND ROWNUM <= NVL(CAB.QTDVOL,1)]]>
	</queryString>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="RAZAOSOCIAL" class="java.lang.String"/>
	<field name="RAZAOPARC" class="java.lang.String"/>
	<field name="TRANSP" class="java.lang.String"/>
	<field name="QTDCAIXA" class="java.math.BigDecimal"/>
	<field name="QTDUNIT" class="java.math.BigDecimal"/>
