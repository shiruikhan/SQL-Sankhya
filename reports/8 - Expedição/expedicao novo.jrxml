<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="expedicao_novo" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NUNOTA" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo-sk.gif"]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\Joao\\Desktop\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
CAB.CODTIPOPER,
TPO.DESCROPER AS DESCTOP,
CAB.DTNEG,
CAB.NUMNOTA AS NumeroPedido,
EMP.RAZAOSOCIAL AS RazaoEmpresa,
EMPEDN.NOMEEND AS EnderecoEmpresa,
EMPBAI.NOMEBAI AS BairroEmpresa,
EMPCID.NOMECID AS CidadeEmpresa,
EMP.NUMEND || ', ' || EMP.COMPLEMENTO AS NroEndEmpresa,
EMP.TELEFONE AS TelEmpresa,
EMP.CGC AS CGCEmpresa,
EMP.INSCESTAD InscEmpresa,
EMPUFS.UF AS UFEmpresa,
EMP.CEP AS CepEmpresa,
PAR.CODPARC || ' - ' ||PAR.NOMEPARC AS NomeParceiro,
PARBAI.NOMEBAI AS BairroParceiro,
PAREDN.NOMEEND AS EndercoParceiro,
PARCID.NOMECID AS CidadeParceiro,
PAR.NUMEND NroEndParceiro,
PAR.TELEFONE AS TelParceiro,
PAR.CGC_CPF AS CGCParceio,
PAR.IDENTINSCESTAD AS InscParceiro,
PARUFS.UF AS UfParceiro,
PAR.CEP AS CepParceiro,
CAB.DTNEG AS DtNegociacao,
CAB.DTFATUR AS DtFaturamento,
CAB.VLRNOTA AS TotalLiquido,
CASE WHEN PARTRANS.CODPARC > 0 THEN PARTRANS.NOMEPARC ELSE ' ' END AS NomeTransportadora,
CAB.AD_OBSINTERNA AS Observacao,
USU.NOMEUSU AS USUARIO,
CAB.NUNOTA,
CAB.DTPREVENT
FROM TGFCAB CAB,
     TSIEMP EMP,
	 TGFPAR PAR,
	 TSIEND EMPEDN,
	 TSIBAI EMPBAI,
	 TSICID EMPCID,
	 TSIUFS EMPUFS,
	 TSIEND PAREDN,
	 TSIBAI PARBAI,
	 TSICID PARCID,
	 TSIUFS PARUFS,
	 TGFTOP TPO,
	 VGFCAB VCAB,
           TGFPAR PARTRANS,
	 TSIUSU USU
WHERE CAB.CODEMP = EMP.CODEMP
  AND PAR.CODPARC = CAB.CODPARC
  AND EMP.CODCID = EMPCID.CODCID
  AND EMP.CODBAI = EMPBAI.CODBAI
  AND EMP.CODEND = EMPEDN.CODEND
  AND EMPCID.UF = EMPUFS.CODUF
  AND PAR.CODEND = PAREDN.CODEND
  AND PAR.CODBAI = PARBAI.CODBAI
  AND PAR.CODCID = PARCID.CODCID
  AND PARCID.UF = PARUFS.CODUF
  AND TPO.CODTIPOPER = CAB.CODTIPOPER
  AND TPO.DHALTER = CAB.DHTIPOPER
  AND VCAB.NUNOTA = CAB.NUNOTA
  AND PARTRANS.CODPARC = CAB.CODPARCTRANSP
  AND USU.CODUSU = CAB.CODUSUINC
  AND CAB.NUNOTA = $P{NUNOTA}
  ORDER BY CAB.NUNOTA]]>
	</queryString>
	<field name="CODTIPOPER" class="java.math.BigDecimal"/>
	<field name="DESCTOP" class="java.lang.String"/>
	<field name="DTNEG" class="java.sql.Timestamp"/>
	<field name="NUMEROPEDIDO" class="java.math.BigDecimal"/>
	<field name="RAZAOEMPRESA" class="java.lang.String"/>
	<field name="ENDERECOEMPRESA" class="java.lang.String"/>
	<field name="BAIRROEMPRESA" class="java.lang.String"/>
	<field name="CIDADEEMPRESA" class="java.lang.String"/>
	<field name="NROENDEMPRESA" class="java.lang.String"/>
	<field name="TELEMPRESA" class="java.lang.String"/>
	<field name="CGCEMPRESA" class="java.lang.String"/>
	<field name="INSCEMPRESA" class="java.lang.String"/>
	<field name="UFEMPRESA" class="java.lang.String"/>
	<field name="CEPEMPRESA" class="java.lang.String"/>
	<field name="NOMEPARCEIRO" class="java.lang.String"/>
	<field name="BAIRROPARCEIRO" class="java.lang.String"/>
	<field name="ENDERCOPARCEIRO" class="java.lang.String"/>
	<field name="CIDADEPARCEIRO" class="java.lang.String"/>
	<field name="NROENDPARCEIRO" class="java.lang.String"/>
	<field name="TELPARCEIRO" class="java.lang.String"/>
	<field name="CGCPARCEIO" class="java.lang.String"/>
	<field name="INSCPARCEIRO" class="java.lang.String"/>
	<field name="UFPARCEIRO" class="java.lang.String"/>
	<field name="CEPPARCEIRO" class="java.lang.String"/>
	<field name="DTNEGOCIACAO" class="java.sql.Timestamp"/>
	<field name="DTFATURAMENTO" class="java.sql.Timestamp"/>
	<field name="TOTALLIQUIDO" class="java.lang.Double"/>
	<field name="NOMETRANSPORTADORA" class="java.lang.String"/>
	<field name="OBSERVACAO" class="java.lang.String"/>
	<field name="USUARIO" class="java.lang.String"/>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="DTPREVENT" class="java.sql.Timestamp"/>
