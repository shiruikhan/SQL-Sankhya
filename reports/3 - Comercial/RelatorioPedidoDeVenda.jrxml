<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RelatorioPedidoDeCompra" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="832" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="83"/>
	<property name="ireport.definition"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="numReg" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(29495)]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo-sk.gif"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="NUNOTA" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[SELECT
CAB.CODTIPOPER,
TPO.DESCROPER AS DESCTOP,
CAB.DTNEG,
CAB.NUMNOTA AS NumeroPedido,
EMP.CODEMP || ' - ' || EMP.RAZAOSOCIAL AS RazaoEmpresa,
EMPEDN.NOMEEND AS EnderecoEmpresa,
EMPBAI.NOMEBAI AS BairroEmpresa,
EMPCID.NOMECID AS CidadeEmpresa,
EMP.NUMEND || ', ' || EMP.COMPLEMENTO AS NroEndEmpresa,
EMP.TELEFONE AS TelEmpresa,
EMP.CGC AS CGCEmpresa,
EMP.INSCESTAD InscEmpresa,
EMPUFS.UF AS UFEmpresa,
EMP.CEP AS CepEmpresa,
PAR.CODPARC || ' - ' || PAR.NOMEPARC AS NomeParceiro,
PARBAI.NOMEBAI AS BairroParceiro,
PAREDN.NOMEEND AS EndercoParceiro,
PARCID.NOMECID AS CidadeParceiro,
PAR.NUMEND NroEndParceiro,
PAR.TELEFONE AS TelParceiro,
PAR.CGC_CPF AS CGCParceio,
PAR.IDENTINSCESTAD AS InscParceiro,
PARUFS.UF AS UfParceiro,
PAR.CEP AS CepParceiro,
CAB.DTNEG AS DtNegociacao,
CAB.DTFATUR AS DtFaturamento,
TPV.DESCRTIPVENDA AS TipoNegociação,
VEN.APELIDO AS Comprador,
ITE.SEQUENCIA AS Sequencia,
ITE.CODPROD AS CodProduto,
PRO.REFFORN AS CodProdFornecedor,
ITE.CODVOL AS Unidade,
PRO.DESCRPROD AS DescProduto,
PRO.MARCA AS Marca,
(SELECT SUM(VALOR) FROM TGFDIN WHERE NUNOTA = $P{NUNOTA} and CODINC = 3 AND CODIMP IN (2,3)) AS IMPFRETE,																										 
ITE.QTDNEG AS QtdPendente,
ITE.VLRUNIT AS VlrUnitario,
ITE.PERCDESC AS PercDesconto,
NVL(ITE.ALIQIPI,0) AS PercIPI,
NVL(ITE.VLRIPI,0) AS VLRIPI,
ITE.VLRSUBST AS VlrST,
ROUND(ITE.VLRUNIT*VCAB.INDITENS,2)AS PrecoFinal,
(ITE.QTDNEG)* ROUND(ITE.VLRUNIT,6) AS TotalItens,
CAB.VLRNOTA-CAB.VLRSUBST-CAB.VLRIPI-(CASE WHEN CAB.TIPFRETE = 'S' AND CAB.CIF_FOB='F' THEN CAB.VLRFRETE ELSE 0 END)+ CAB.VLRDESCTOT+CAB.VLRDESCTOTITEM AS TotalBruto,
(SELECT SUM(NVL((I.QTDNEG-I.QTDENTREGUE)* ROUND(I.VLRUNIT,2),0)) FROM TGFITE I, TGFPRO P WHERE I.CODPROD = P.CODPROD AND I.NUNOTA = ITE.NUNOTA AND P.USOPROD = 'S') AS TOTSERV,
(SELECT SUM(NVL((IT.QTDNEG-IT.QTDENTREGUE)* ROUND(IT.VLRUNIT,2),0)) FROM TGFITE IT, TGFPRO PR WHERE IT.CODPROD = PR.CODPROD AND IT.NUNOTA = ITE.NUNOTA AND PR.USOPROD <> 'S') AS TOTPROD,
NVL(ITE.VLRTOT,0)+NVL(ITE.VLRIPI,0) + NVL(ITE.VLRSUBST,0) AS TOTITEIPIST,
NVL(CAB.VLRSUBST,0) AS VlrTotalST,
NVL(CAB.VLRIPI,0) AS VlrTotalIPI,
NVL(CAB.VLRDESCTOT,0)+ NVL(CAB.VLRDESCTOTITEM,0) AS DescontoTotal,
(CASE WHEN CAB.TIPFRETE = 'N' THEN 0 ELSE NVL(CAB.VLRFRETE,0) END) AS Frete,
ROUND((CAB.VLRFRETE/CAB.VLRNOTA)*100,2) AS PERCFRETE,
CAB.VLRNOTA AS TotalLiquido,
CASE WHEN PARTRANS.CODPARC > 0 THEN PARTRANS.NOMEPARC ELSE ' ' END AS NomeTransportadora,
CAB.OBSERVACAO || (CASE WHEN AD_OBSINTERNA IS NULL THEN ' ' ELSE ' - Observação Interna: ' END) || AD_OBSINTERNA AS Observacao,
USU.NOMEUSU AS USUARIO,
CAB.CODVEND AS CODVEND,
ITE.OBSERVACAO AS OBSERVACAOITE,
ITE.VLRTOT AS VLRTOT,
CAB.NUNOTA,
ITE.VLRDESC AS DESCITEM,
(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRSUBST + ITE.VLRIPI - ITE.VLRREPRED) AS TOTLIQ,
ITE.VLRUNIT - (ITE.VLRDESC/ITE.QTDNEG) as VLRUNITLQ,
(ITE.VLRUNIT - (ITE.VLRDESC/ITE.QTDNEG)) * ITE.QTDNEG AS TOTALPRODLIQ,
(CASE WHEN CAB.TIPFRETE = 'S' THEN 'Incluso' ELSE 'E. N.' END) AS TIPFRETE
FROM TGFCAB CAB,
     TSIEMP EMP,
	 TGFPAR PAR,
	 TGFVEN VEN,
	 TSIEND EMPEDN,
	 TSIBAI EMPBAI,
	 TSICID EMPCID,
	 TSIUFS EMPUFS,
	 TSIEND PAREDN,
	 TSIBAI PARBAI,
	 TSICID PARCID,
	 TSIUFS PARUFS,
	 TGFTPV TPV,
	 TGFTOP TPO,
	 TGFITE ITE,
	 TGFPRO PRO,
	 VGFCAB VCAB,
     TGFPAR PARTRANS,
	 TSIUSU USU
WHERE CAB.CODEMP = EMP.CODEMP
  AND PAR.CODPARC = CAB.CODPARC
  AND CAB.CODVEND = VEN.CODVEND
  AND EMP.CODCID = EMPCID.CODCID
  AND EMP.CODBAI = EMPBAI.CODBAI
  AND EMP.CODEND = EMPEDN.CODEND
  AND EMPCID.UF = EMPUFS.CODUF
  AND PAR.CODEND = PAREDN.CODEND
  AND PAR.CODBAI = PARBAI.CODBAI
  AND PAR.CODCID = PARCID.CODCID
  AND PARCID.UF = PARUFS.CODUF
  AND TPV.CODTIPVENDA = CAB.CODTIPVENDA
  AND TPV.DHALTER = CAB.DHTIPVENDA
  AND TPO.CODTIPOPER = CAB.CODTIPOPER
  AND TPO.DHALTER = CAB.DHTIPOPER
  AND ITE.NUNOTA = CAB.NUNOTA
  AND PRO.CODPROD = ITE.CODPROD
  AND VCAB.NUNOTA = CAB.NUNOTA
  AND PARTRANS.CODPARC = CAB.CODPARCTRANSP
  AND USU.CODUSU = CAB.CODUSUINC
  AND CAB.NUNOTA = $P{NUNOTA}
  ORDER BY ITE.SEQUENCIA]]>
	</queryString>
