<gadget>
  <prompt-parameters>
    <parameter id="P_CODVOL" description="Un. de Medida" metadata="entity:Volume@CODVOL" required="true" keep-last="true" keep-date="false" order="0"/>
  </prompt-parameters>
  <level id="lvl_pdn728" description="Principal">
    <container orientacao="V" tamanhoRelativo="100">
      <grid id="grd_pdn729" multiplaSelecao="S" useNewGrid="S">
        <expression type="sql" data-source="MGEDS"><![CDATA[SELECT ITE.NUNOTA,	ITE.CODPROD,	PRO.DESCRPROD,	ITE.CODVOL AS ITECODVOL,	PRO.CODVOL AS PROCODVOL,	PRO.CODVOLCOMPRA AS CODVOLCOMPRA,	VOA.CODVOL AS VOLCODVOLFROM TGFITE ITE	INNER JOIN TGFPRO PRO ON ITE.CODPROD = PRO.CODPROD	LEFT JOIN TGFVOA VOA ON PRO.CODPROD = VOA.CODPRODWHERE PRO.CODVOL = :P_CODVOL	OR PRO.CODVOLCOMPRA = :P_CODVOL	OR ITE.CODVOL = :P_CODVOL	OR VOA.CODVOL = :P_CODVOLORDER BY ITE.NUNOTA, PRO.CODPROD]]></expression>
        <metadata>
          <field name="NUNOTA" label="Nr. Único" type="I" visible="true" useFooter="false"/>
          <field name="CODPROD" label="Cód. Produto" type="I" visible="true" useFooter="false"/>
          <field name="DESCRPROD" label="Produto" type="S" visible="true" useFooter="false"/>
          <field name="ITECODVOL" label="Unidade no Lançamento" type="S" visible="true" useFooter="false"/>
          <field name="PROCODVOL" label="Unidade no Cadastro" type="S" visible="true" useFooter="false"/>
          <field name="CODVOLCOMPRA" label="Unidade de Compra" type="S" visible="true" useFooter="false"/>
          <field name="VOLCODVOL" label="Unidade Alternativa" type="S" visible="true" useFooter="false"/>
        </metadata>
        <on-click-launcher resource-id="br.com.sankhya.com.mov.CentralNotas">
          <NUNOTA>$NUNOTA</NUNOTA>
        </on-click-launcher>
      </grid>
    </container>
  </level>
</gadget>