<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="conferencia_2" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    PRO.CODPROD , PRO.DESCRPROD, PRO.M3, PRO.PESOBRUTO,
    SUM(PROD.PESOBRUTO) AS PESOBRUTOPROD,
    SUM(V.PESOBRUTO) AS PESO,
    COUNT(DISTINCT IDCAIXA)  AS QTDCAIXA ,
    SUM(V.M3) AS M3TOT,
    PRO.PESOBRUTO * COUNT(DISTINCT IDCAIXA) AS PESOTOTCAIXA,
    (PRO.PESOBRUTO * COUNT(DISTINCT IDCAIXA)) + SUM(V.PESOBRUTO) AS PESOTOTAL
FROM AD_EMBPED V, TGFPRO PRO, TGFPRO PROD
WHERE V.CODPRODEMB = PRO.CODPROD
   AND V.CODPROD = PROD.CODPROD
   AND V.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})
GROUP BY PRO.CODPROD , PRO.DESCRPROD, PRO.M3, PRO.PESOBRUTO]]>
	</queryString>
	<field name="CODPROD" class="java.math.BigDecimal"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="M3" class="java.math.BigDecimal"/>
	<field name="PESOBRUTO" class="java.math.BigDecimal"/>
	<field name="PESO" class="java.math.BigDecimal"/>
	<field name="QTDCAIXA" class="java.math.BigDecimal"/>
	<field name="M3TOT" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="PESOBRUTOPROD" class="java.math.BigDecimal"/>
	<field name="PESOTOTCAIXA" class="java.math.BigDecimal"/>
	<field name="PESOTOTAL" class="java.math.BigDecimal"/>
	<variable name="PESO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESO}]]></variableExpression>
	</variable>
	<variable name="QTDCAIXA_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{QTDCAIXA}]]></variableExpression>
	</variable>
	<variable name="M3TOT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{M3TOT}]]></variableExpression>
	</variable>
	<variable name="PESOBRUTO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOBRUTO}]]></variableExpression>
	</variable>
	<variable name="PESOBRUTOPROD_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOBRUTOPROD}]]></variableExpression>
	</variable>
	<variable name="PESOTOTCAIXA_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOTOTCAIXA}]]></variableExpression>
	</variable>
	<variable name="PESOTOTAL_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOTOTAL}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="21" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="1" y="0" width="237" height="20" backcolor="#CCCCCC"/>
