			<staticText>
				<reportElement mode="Opaque" x="396" y="0" width="79" height="20" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Peso Tot.Emb.]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="475" y="0" width="79" height="20" backcolor="#CCCCCC"/>
