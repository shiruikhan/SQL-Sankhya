  <level id="lvl_44smnw" description="Operações Concluídas">
    <container orientacao="V" tamanhoRelativo="100">
      <grid id="grd_44smnx" multiplaSelecao="S" useNewGrid="S">
        <title><![CDATA[Operações Concluídas]]></title>
        <expression type="sql" data-source="MGEDS"><![CDATA[SELECT 	FIN.NUFIN,	FIN.NUNOTA,	FIN.NUMNOTA,	FIN.DTNEG,	FIN.DESDOBRAMENTO,	FIN.CODTIPTIT,	TIT.DESCRTIPTIT,	FIN.DTVENC,	FIN.DHBAIXA,	FIN.CODPARC,	PAR.RAZAOSOCIAL,	FIN.VLRDESDOB,	FIN.VLRJURO,	FIN.VLRDESC,	V.DESPCART,	(SELECT C.CODCTABCO FROM TSICTA C WHERE C.CODCTABCOINT = FIN.CODCTABCOINT) AS CODCTABCOINT,	V.CARTAODESC,	V.VLRLIQUIDO,	FIN.CODNAT,	V.VLRMULTA,	(SELECT M.DHCONCILIACAO FROM TGFMBC M WHERE M.NUBCO = FIN.NUBCO) AS DHCONCIL,	FIN.VLRVARCAMBIAL,	(SELECT DISTINCT N.DESCRNAT FROM TGFNAT N WHERE N.CODNAT = FIN.CODNAT) AS NATUREZA,    (SELECT MAX(T.DESCROPER) FROM TGFTOP T WHERE T.CODTIPOPER = FIN.CODTIPOPER) AS DESCROPER,    FIN.VLRMOEDABAIXA,	FIN.VLRBAIXAFROM TGFFIN FIN	INNER JOIN TGFPAR PAR 		ON FIN.CODPARC = PAR.CODPARC	INNER JOIN VGFFIN V 		ON FIN.NUFIN = V.NUFIN	INNER JOIN TGFTIT TIT 		ON FIN.CODTIPTIT = TIT.CODTIPTIT		INNER JOIN TGFMBC MBC 		ON MBC.NUBCO = FIN.NUBCOWHERE FIN.RECDESP = :P_RECDESP	AND FIN.DHBAIXA IS NOT NULL	AND FIN.PROVISAO = 'N'	AND MBC.DHCONCILIACAO >= :P_DTVENC.INI	AND MBC.DHCONCILIACAO <= :P_DTVENC.FIN	AND (:P_CODEMP IS NULL OR FIN.CODEMP = :P_CODEMP)	AND (FIN.CODNAT IS NULL OR FIN.CODNAT IN :P_CODNAT)ORDER BY FIN.DTVENC]]></expression>
        <metadata>
          <field name="NUFIN" label="Nr. Financeiro" type="I" visible="true" useFooter="false"/>
          <field name="NUNOTA" label="Nr. Único" type="I" visible="true" useFooter="false"/>
          <field name="NUMNOTA" label="Nr. Nota" type="I" visible="true" useFooter="false"/>
          <field name="DTNEG" label="Dt. Negociação" type="D" visible="true" useFooter="false" mask="DD/MM/YYYY"/>
          <field name="DESDOBRAMENTO" label="Parcela" type="S" visible="true" useFooter="false"/>
          <field name="CODTIPTIT" label="Cod. Tip. Título" type="I" visible="true" useFooter="false"/>
          <field name="DESCRTIPTIT" label="Tipo de Título" type="S" visible="true" useFooter="false"/>
          <field name="DTVENC" label="Dt. Vencimento" type="D" visible="true" useFooter="false" mask="DD/MM/YYYY"/>
          <field name="DHBAIXA" label="Dt. Baixa" type="D" visible="true" useFooter="false" mask="DD/MM/YYYY"/>
          <field name="CODPARC" label="Cód. Parceiro" type="I" visible="true" useFooter="false"/>
          <field name="RAZAOSOCIAL" label="Razão Social" type="S" visible="true" useFooter="false"/>
          <field name="VLRDESDOB" label="Vlr. Desdobramento" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="VLRJURO" label="Vlr. Juros" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="VLRDESC" label="Vlr. Desconto" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="DESPCART" label="Vlr. Desp. Cartório" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="CODCTABCOINT" label="Conta da Baixa" type="I" visible="true" useFooter="false"/>
          <field name="CARTAODESC" label="Vlr. Cartão" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="VLRLIQUIDO" label="Vlr. Líquido" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="CODNAT" label="Cód. Nat." type="I" visible="true" useFooter="false"/>
          <field name="VLRMULTA" label="Vlr. Multa" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="DHCONCIL" label="Dt. Conciliação" type="D" visible="true" useFooter="false"/>
          <field name="VLRVARCAMBIAL" label="Variação Cambial" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="NATUREZA" label="Natureza" type="S" visible="true" useFooter="false"/>
          <field name="DESCROPER" label="DESCROPER" type="S" visible="true" useFooter="false"/>
          <field name="VLRMOEDABAIXA" label="VLRMOEDABAIXA" type="F" visible="true" useFooter="false"/>
          <field name="VLRBAIXA" label="Vlr. Baixa" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
        </metadata>
      </grid>
    </container>
  </level>
  <level id="lvl_44smin" description="Operações Não Concluídas">
    <container orientacao="V" tamanhoRelativo="100">
      <grid id="grd_44smio" multiplaSelecao="S" useNewGrid="S">
        <title><![CDATA[Relação de Operações]]></title>
        <expression type="sql" data-source="MGEDS"><![CDATA[SELECT FIN.NUFIN,	FIN.NUNOTA,	FIN.NUMNOTA,	FIN.DTNEG,	FIN.DESDOBRAMENTO,	FIN.CODTIPTIT,	TIT.DESCRTIPTIT,	FIN.DTVENC,	FIN.DHBAIXA,	FIN.CODPARC,	PAR.RAZAOSOCIAL,	FIN.VLRDESDOB,	FIN.VLRJURO,    (SELECT M.DHCONCILIACAO FROM TGFMBC M WHERE M.NUBCO = FIN.NUBCO) AS DHCONCIL,	FIN.VLRDESC,	V.DESPCART,	V.CARTAODESC,	V.VLRLIQUIDO,	FIN.CODNAT,	FIN.VLRMULTA,	FIN.VLRVARCAMBIAL,	(SELECT DISTINCT N.DESCRNAT FROM TGFNAT N WHERE N.CODNAT = FIN.CODNAT) AS NATUREZA,	FIN.VLRBAIXAFROM TGFFIN FIN	INNER JOIN TGFPAR PAR 		ON FIN.CODPARC = PAR.CODPARC	INNER JOIN VGFFIN V 		ON FIN.NUFIN = V.NUFIN	INNER JOIN TGFTIT TIT 		ON FIN.CODTIPTIT = TIT.CODTIPTIT		WHERE FIN.RECDESP = :P_RECDESP	AND FIN.PROVISAO = 'N'	AND NVL(FIN.DTENTSAI, FIN.DTNEG) <= :P_DTCORTE    AND (FIN.DHBAIXA IS NULL OR FIN.DHBAIXA > :P_DTCORTE) 	AND (:P_CODEMP IS NULL 			OR FIN.CODEMP = :P_CODEMP		)	AND FIN.CODNAT IN :P_CODNATORDER BY FIN.DTVENC]]></expression>
        <metadata>
          <field name="NUFIN" label="Nr. Financeiro" type="I" visible="true" useFooter="false"/>
          <field name="NUNOTA" label="Nr. Único" type="I" visible="true" useFooter="false"/>
          <field name="NUMNOTA" label="Nr. Nota" type="I" visible="true" useFooter="false"/>
          <field name="DTNEG" label="Dt. Negociação" type="D" visible="true" useFooter="false" mask="DD/MM/YYYY"/>
          <field name="DESDOBRAMENTO" label="Parcela" type="S" visible="true" useFooter="false"/>
          <field name="CODTIPTIT" label="Cód. Tip. Título" type="I" visible="true" useFooter="false"/>
          <field name="DESCRTIPTIT" label="Tipo de Título" type="S" visible="true" useFooter="false"/>
          <field name="DTVENC" label="Dt. Vencimento" type="D" visible="true" useFooter="false" mask="DD/MM/YYYY"/>
          <field name="DHBAIXA" label="Dt. Baixa" type="D" visible="true" useFooter="false" mask="DD/MM/YYYY"/>
          <field name="CODPARC" label="Cód. Parceiro" type="I" visible="true" useFooter="false"/>
          <field name="RAZAOSOCIAL" label="Razão Social" type="S" visible="true" useFooter="false"/>
          <field name="VLRDESDOB" label="Vlr. Desdobramento" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="VLRJURO" label="Vlr. Juros" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="DHCONCIL" label="Dt. Conciliação" type="D" visible="true" useFooter="false"/>
          <field name="VLRDESC" label="Vlr. Desconto" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="DESPCART" label="Vlr. Desp. Cartório" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="CARTAODESC" label="Vlr. Cartão" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="VLRLIQUIDO" label="Vlr. Líquido" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="CODNAT" label="Cód. Nat." type="I" visible="true" useFooter="false"/>
          <field name="VLRMULTA" label="Vlr. Multa" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="VLRVARCAMBIAL" label="Variação Cambial" type="F" visible="true" useFooter="false"/>
          <field name="NATUREZA" label="Natureza" type="S" visible="true" useFooter="false"/>
          <field name="VLRBAIXA" label="Vlr. Baixa" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
        </metadata>
        <on-click-launcher resource-id="br.com.sankhya.fin.cad.movimentacaoFinanceira">
          <NUFIN>$NUFIN</NUFIN>
        </on-click-launcher>
