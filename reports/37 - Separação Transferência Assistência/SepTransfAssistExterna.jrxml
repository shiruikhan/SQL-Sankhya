						<font size="8" isBold="true"/>
					</textElement>
					<text><![CDATA[Período:]]></text>
				</staticText>
				<textField isBlankWhenNull="true">
					<reportElement x="68" y="50" width="250" height="14"/>
					<textElement verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[($P{P_DTINI} == null ? "sem limite" : new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{P_DTINI})) + " a " + ($P{P_DTFIN} == null ? "sem limite" : new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{P_DTFIN}))]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="330" y="50" width="70" height="14"/>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font size="8" isBold="true"/>
					</textElement>
					<text><![CDATA[Emissão:]]></text>
				</staticText>
				<textField pattern="dd/MM/yyyy HH:mm">
