<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RelatorioPedidoDeCompra" pageWidth="595" pageHeight="842" columnWidth="585" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.6500000000000024"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="numReg" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(29495)]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo-sk.gif"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="NUNOTA" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[SELECT CAB.CODTIPOPER,
	CAB.CODPARC,
	TPO.DESCROPER AS DESCTOP,
	CAB.DTNEG,
	(CASE WHEN ITE.CODVOL = PRO.CODVOL THEN ITE.QTDNEG ELSE (CASE WHEN VOA.DIVIDEMULTIPLICA = 'M' THEN ITE.QTDNEG / VOA.QUANTIDADE ELSE ITE.QTDNEG * VOA.QUANTIDADE END) END) AS QTDNEG,
	CAB.NUMNOTA AS NumeroPedido,
	EMP.CODEMP || '-' || EMP.RAZAOSOCIAL AS RazaoEmpresa,
	EMPEDN.NOMEEND AS EnderecoEmpresa,
	EMPBAI.NOMEBAI AS BairroEmpresa,
	EMPCID.NOMECID AS CidadeEmpresa,
	EMP.NUMEND || ', ' || EMP.COMPLEMENTO AS NroEndEmpresa,
	EMP.TELEFONE AS TelEmpresa,
	EMP.CGC AS CGCEmpresa,
	EMP.INSCESTAD InscEmpresa,
	EMPUFS.UF AS UFEmpresa,
	EMP.CEP AS CepEmpresa,
	PAR.NOMEPARC AS NomeParceiro,
	PARBAI.NOMEBAI AS BairroParceiro,
	PAREDN.NOMEEND AS EndercoParceiro,
	PARCID.NOMECID AS CidadeParceiro,
	PAR.NUMEND NroEndParceiro,
	PAR.TELEFONE AS TelParceiro,
	PAR.CGC_CPF AS CGCParceio,
	PAR.IDENTINSCESTAD AS InscParceiro,
	PARUFS.UF AS UfParceiro,
	PAR.CEP AS CepParceiro,
	CAB.DTNEG AS DtNegociacao,
	CAB.DTFATUR AS DtFaturamento,
	TPV.DESCRTIPVENDA AS TipoNegociação,
	VEN.APELIDO AS Comprador,
	ITE.SEQUENCIA AS Sequencia,
	ITE.CODPROD AS CodProduto,
	PRO.REFFORN AS CodProdFornecedor,
	ITE.CODVOL AS Unidade,
	PRO.DESCRPROD AS DescProduto,
	PRO.MARCA AS Marca,
	--ITE.QTDNEG AS QtdPendente,
	ITE.VLRUNIT AS VlrUnitario,
	ITE.PERCDESC AS PercDesconto,
	NVL(ITE.ALIQIPI,0) AS PercIPI,
	NVL(ITE.VLRIPI,0) AS VLRIPI,
	ITE.VLRSUBST AS VlrST,
	ROUND(ITE.VLRUNIT*VCAB.INDITENS,2)AS PrecoFinal,
	(ITE.QTDNEG)* ROUND(ITE.VLRUNIT,6) AS TotalItens,
	CAB.VLRNOTA-CAB.VLRSUBST-CAB.VLRIPI-(CASE WHEN CAB.TIPFRETE = 'S' AND CAB.CIF_FOB='F' THEN CAB.VLRFRETE ELSE 0 END)+ CAB.VLRDESCTOT+CAB.VLRDESCTOTITEM AS TotalBruto,
	(SELECT SUM(NVL((I.QTDNEG-I.QTDENTREGUE)* ROUND(I.VLRUNIT,2),0)) FROM TGFITE I, TGFPRO P WHERE I.CODPROD = P.CODPROD AND I.NUNOTA = ITE.NUNOTA AND P.USOPROD = 'S') AS TOTSERV,
	(SELECT SUM(NVL((IT.QTDNEG-IT.QTDENTREGUE)* ROUND(IT.VLRUNIT,2),0)) FROM TGFITE IT, TGFPRO PR WHERE IT.CODPROD = PR.CODPROD AND IT.NUNOTA = ITE.NUNOTA AND PR.USOPROD <> 'S') AS TOTPROD,
	NVL(ITE.VLRTOT,0)+NVL(ITE.VLRIPI,0) + NVL(ITE.VLRSUBST,0) AS TOTITEIPIST,
	NVL(CAB.VLRSUBST,0) AS VlrTotalST,
	NVL(CAB.VLRIPI,0) AS VlrTotalIPI,
	NVL(CAB.VLRDESCTOT,0)+ NVL(CAB.VLRDESCTOTITEM,0) AS DescontoTotal,
	NVL(CAB.VLRFRETE,0) AS Frete,
	CAB.VLRNOTA AS TotalLiquido,
	CASE WHEN PARTRANS.CODPARC > 0 THEN PARTRANS.NOMEPARC ELSE ' ' END AS NomeTransportadora,
	CAB.OBSERVACAO AS Observacao,
	USU.NOMEUSU AS USUARIO,
	CAB.CODVEND AS CODVEND,
	ITE.OBSERVACAO AS OBSERVACAOITE,
	ITE.VLRTOT AS VLRTOT
FROM TGFCAB CAB
	INNER JOIN TSIEMP EMP ON CAB.CODEMP = EMP.CODEMP
	INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
	INNER JOIN TGFVEN VEN ON CAB.CODVEND = VEN.CODVEND
	INNER JOIN TSIEND EMPEDN ON EMP.CODEND = EMPEDN.CODEND
	INNER JOIN TSIBAI EMPBAI ON EMP.CODBAI = EMPBAI.CODBAI
	INNER JOIN TSICID EMPCID ON EMP.CODCID = EMPCID.CODCID
	INNER JOIN TSIUFS EMPUFS ON EMPCID.UF = EMPUFS.CODUF
	INNER JOIN TSIEND PAREDN ON PAR.CODEND = PAREDN.CODEND
	INNER JOIN TSIBAI PARBAI ON PAR.CODBAI = PARBAI.CODBAI
	INNER JOIN TSICID PARCID ON PAR.CODCID = PARCID.CODCID
	INNER JOIN TSIUFS PARUFS ON PARCID.UF = PARUFS.CODUF
	INNER JOIN TGFTPV TPV ON (TPV.CODTIPVENDA = CAB.CODTIPVENDA AND TPV.DHALTER = CAB.DHTIPVENDA)
	INNER JOIN TGFTOP TPO ON (TPO.CODTIPOPER = CAB.CODTIPOPER AND TPO.DHALTER = CAB.DHTIPOPER)
	INNER JOIN TGFITE ITE ON ITE.NUNOTA = CAB.NUNOTA
	INNER JOIN TGFPRO PRO ON PRO.CODPROD = ITE.CODPROD
	INNER JOIN VGFCAB VCAB ON VCAB.NUNOTA = CAB.NUNOTA
	INNER JOIN TGFPAR PARTRANS ON PARTRANS.CODPARC = CAB.CODPARCTRANSP
	LEFT JOIN TGFVOA VOA ON (ITE.CODPROD = VOA.CODPROD AND ITE.CODVOL = VOA.CODVOL)
	INNER JOIN TSIUSU USU ON USU.CODUSU = CAB.CODUSUINC
WHERE CAB.NUNOTA = $P{NUNOTA}
	AND ITE.SEQUENCIA > 0
ORDER BY ITE.SEQUENCIA]]>
	</queryString>
