				<textFieldExpression class="java.lang.String"><![CDATA[($F{Credito_1} == null || $F{Credito_1}.doubleValue() == 0) ? "-" : new java.text.DecimalFormat("R$ #,##0.00", new java.text.DecimalFormatSymbols(new java.util.Locale("pt", "BR"))).format($F{Credito_1})]]></textFieldExpression>
