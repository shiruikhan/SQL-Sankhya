	<field name="NUMINVOICE" class="java.lang.String"/>
	<field name="NRINVOICE" class="java.lang.String"/>
	<field name="MARCA" class="java.lang.String"/>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="CODVEND" class="java.math.BigDecimal"/>
	<field name="CODPARC" class="java.math.BigDecimal"/>
	<field name="OTHER" class="java.math.BigDecimal"/>
	<field name="INSURANCE" class="java.math.BigDecimal"/>
	<field name="SEQUENCIA" class="java.math.BigDecimal"/>
	<field name="CODPROD" class="java.math.BigDecimal"/>
	<field name="NCM" class="java.lang.String"/>
	<field name="PESOBRUTO" class="java.math.BigDecimal"/>
	<field name="VLRUNIT" class="java.math.BigDecimal"/>
	<field name="VLRTOT" class="java.math.BigDecimal"/>
	<field name="PESOTOTAL" class="java.math.BigDecimal"/>
	<field name="VLRFRETEUSD" class="java.math.BigDecimal"/>
	<field name="VLRTOTFRETE" class="java.math.BigDecimal"/>
	<field name="AD_NRPO" class="java.math.BigDecimal"/>
	<field name="DTDIA" class="java.sql.Timestamp"/>
	<field name="DTFATUR" class="java.sql.Timestamp"/>
	<variable name="VLRTOT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRTOT}.setScale(2, java.math.RoundingMode.HALF_UP)]]></variableExpression>
	</variable>
	<variable name="PESOTOT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOTOT}]]></variableExpression>
	</variable>
