	<field name="TELEFONE_DESTINTARIO" class="java.lang.String"/>
	<field name="PAIS_DESTINATARIO2" class="java.lang.String"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="TEMHTS" class="java.lang.String"/>
	<field name="CODVOL" class="java.lang.String"/>
	<field name="TRANSPORTE" class="java.lang.String"/>
