        <expression type="sql" data-source="MGEDS"><![CDATA[SELECT NUMPEDVEN,	NUMNFSAIDA,	CODPRODUTO,	DESCPRODUTONOTA,	REFERENCIAINTERNA,	NUMSERIAL,	RAZAOSOCIAL,	PLANO,	ANO,	DATAEMISSAOFROM AD_ANDSER ANSWHERE (:P_NUMSERIAL IS NULL OR ANS.NUMSERIAL = :P_NUMSERIAL)	AND (:P_NUMNFSAIDA IS NULL OR ANS.NUMNFSAIDA = :P_NUMNFSAIDA)]]></expression>
