<gadget>
  <prompt-parameters>
    <parameter id="P_PERIODO" description="Dt de Baixa" metadata="datePeriod" required="true" keep-last="true" keep-date="false" order="0"/>
    <parameter id="P_CODPARC" description="Parceiro" metadata="entity:Parceiro@CODPARC" required="false" keep-last="false" keep-date="false" order="1"/>
    <parameter id="P_RECDESP" description="Receita/Despesa" metadata="singleList:Text" listType="text" required="true" keep-last="true" keep-date="false" order="2">
      <item value="1" label="Receita"/>
      <item value="-1" label="Despesa"/>
    </parameter>
    <parameter id="P_CODEMP" description="Empresa" metadata="multiList:Text" listType="sql" required="true" keep-last="false" keep-date="false" order="3">
      <expression type="SQL"><![CDATA[SELECT CODEMP AS VALUE, CODEMP || ' - ' || NOMEFANTASIA AS LABEL FROM TSIEMP]]></expression>
    </parameter>
  </prompt-parameters>
  <level id="lvl_0v9mkv" description="Principal">
    <container orientacao="V" tamanhoRelativo="100">
      <grid id="grd_0v9mkw" useNewGrid="S">
        <expression type="sql" data-source="MGEDS"><![CDATA[SELECT FIN.NUFIN,	FIN.NUMNOTA,	FIN.CODPARC,	PAR.NOMEPARC,	FIN.DTVENC,	FIN.DHBAIXA,	FIN.VLRDESDOB,	FIN.VLRDESC, FIN.HISTORICOFROM TGFFIN FIN	INNER JOIN TGFPAR PAR ON FIN.CODPARC = PAR.CODPARCWHERE (FIN.DHBAIXA >= :P_PERIODO.INI AND FIN.DHBAIXA <= :P_PERIODO.FIN)	AND FIN.CODEMP IN :P_CODEMP	AND FIN.RECDESP IN :P_RECDESP	AND FIN.VLRDESC > 0]]></expression>
        <metadata>
          <field name="NUFIN" label="Nr. Único Financeiro" type="I" visible="true" useFooter="false"/>
          <field name="NUMNOTA" label="Nr. Nota" type="I" visible="true" useFooter="false"/>
          <field name="CODPARC" label="Cod. Parceiro" type="I" visible="true" useFooter="false"/>
          <field name="NOMEPARC" label="Nome Parceiro" type="S" visible="true" useFooter="false"/>
          <field name="DTVENC" label="Dt. Vencimento" type="D" visible="true" useFooter="false"/>
          <field name="DHBAIXA" label="Dt. Baixa" type="D" visible="true" useFooter="false"/>
          <field name="VLRDESDOB" label="Vlr. Desdobramento" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="VLRDESC" label="Vlr. Desconto" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"/>
          <field name="HISTORICO" label="Historico" type="S" visible="true" useFooter="false"/>
        </metadata>
        <on-click-launcher resource-id="br.com.sankhya.fin.cad.movimentacaoFinanceira">
          <NUFIN>$NUFIN</NUFIN>
        </on-click-launcher>
      </grid>
    </container>
  </level>
</gadget>