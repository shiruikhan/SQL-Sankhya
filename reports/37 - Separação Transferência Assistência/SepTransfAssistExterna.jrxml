					<textFieldExpression class="java.lang.String"><![CDATA["Local " + $F{CODLOCALORIG} + ($F{DESCRLOCALORIG} == null ? "" : " - " + $F{DESCRLOCALORIG})]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="6" y="38" width="62" height="16"/>
					<textElement verticalAlignment="Middle">
						<font size="9" isBold="true"/>
					</textElement>
					<text><![CDATA[Levar para:]]></text>
				</staticText>
				<textField isBlankWhenNull="true">
					<reportElement x="68" y="38" width="460" height="16"/>
