<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OS_Interna" language="groovy" pageWidth="595" pageHeight="842" columnWidth="539" leftMargin="28" rightMargin="28" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="2.1435888100000016"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUMOS" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[Nr. OS]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    OSI.NUMOS,
    TO_CHAR(OSI.DHCRIACAO, 'DD/MM/YYYY HH24:MI') AS DHCRIACAO,
    CASE OSI.SETOR
        WHEN 'T' THEN 'TI'
        WHEN 'M' THEN 'PCM / Manutencao'
        ELSE OSI.SETOR END AS SETOR,
    CASE OSI.STATUS
        WHEN 'I' THEN 'Iniciada'
        WHEN 'A' THEN 'Em Andamento'
        WHEN 'P' THEN 'Programada'
        WHEN 'F' THEN 'Finalizada'
        WHEN 'C' THEN 'Cancelada'
        ELSE OSI.STATUS END AS STATUS,
    CASE OSI.PRIORIDADE
        WHEN '1' THEN 'URGENTE'
        WHEN '2' THEN 'ALTA'
        WHEN '3' THEN 'NORMAL'
        ELSE NVL(OSI.PRIORIDADE, '-') END AS PRIORIDADE,
    TO_CHAR(OSI.DEADLINE, 'DD/MM/YYYY HH24:MI') AS DEADLINE,
    TO_CHAR(OSI.DTPROGRAMADA, 'DD/MM/YYYY') AS DTPROGRAMADA,
    NVL(OSI.CODPAT, '-') AS CODPAT,
    CASE OSI.TIPOMANUTENCAO
        WHEN 'CP' THEN 'PCM - Corretiva Programada'
        WHEN 'CE' THEN 'PCM - Corretiva Emergencial'
        WHEN 'P'  THEN 'PCM - Preventiva'
        WHEN 'C'  THEN 'PCM - Condicional'
        WHEN 'TC' THEN 'TI - Corretiva'
        WHEN 'TE' THEN 'TI - Evolutiva'
        WHEN 'TA' THEN 'TI - Adaptativa'
        WHEN 'TP' THEN 'TI - Preventiva'
        ELSE NVL(OSI.TIPOMANUTENCAO, '-') END AS TIPOMANUTENCAO,
    CASE OSI.NATUREZAMANUTENCAO
        WHEN 'E'   THEN 'PCM - Elétrica'
        WHEN 'P'   THEN 'PCM - Predial'
        WHEN 'M'   THEN 'PCM - Mecânica'
        WHEN 'BUG' THEN 'TI - Correção de Erro'
        WHEN 'MF'  THEN 'TI - Melhoria de Funcionalidade'
        WHEN 'D'   THEN 'TI - Desenvolvimento'
        WHEN 'ST'  THEN 'TI - Suporte Técnico'
        WHEN 'R'   THEN 'TI - Criação ou Ajuste de Relatórios'
        ELSE NVL(OSI.NATUREZAMANUTENCAO, '-') END AS NATUREZAMANUTENCAO,
    NVL(OSI.MANUTENTOR, '-') AS MANUTENTOR,
    CASE OSI.EXECUTANTE
        WHEN 'I' THEN 'Interno'
        WHEN 'T' THEN 'Terceiro'
        ELSE NVL(OSI.EXECUTANTE, '-') END AS EXECUTANTE,
    DBMS_LOB.SUBSTR(OSI.PROBAPONTADO, 4000, 1) AS PROBAPONTADO,
    DBMS_LOB.SUBSTR(OSI.OBSERVACAO, 4000, 1) AS OBSERVACAO,
    NVL(USU.NOMEUSU, '-') AS SOLICITANTE,
    OSI.CODCENCUS || ' - ' || NVL(CEN.DESCRCENCUS, '') AS CENTROCUSTO
FROM AD_OSINTERNA OSI
    LEFT JOIN TSIUSU USU ON OSI.CODUSUCRI = USU.CODUSU
    LEFT JOIN TSICUS CEN ON OSI.CODCENCUS = CEN.CODCENCUS
WHERE OSI.NUMOS = $P{PK_NUMOS}]]>
	</queryString>
