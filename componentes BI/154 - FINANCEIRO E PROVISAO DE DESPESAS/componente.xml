<gadget ><prompt-parameters><parameter  id="P_PERIODO" description="Período" metadata="datePeriod" required="true" keep-last="false" keep-date="false" order="0" label="P_PERIODO : Período"/><parameter  id="P_CODEMP" description="Empresa" metadata="entity:Empresa@CODEMP" required="false" keep-last="false" keep-date="false" order="1" label="P_CODEMP : Entidade/Tabela"/><parameter  id="P_RECDESP" description="Tipo" metadata="singleList:Text" listType="text" required="true" keep-last="true" keep-date="false" show-inactives="false" label="P_RECDESP : singleList:Text" order="2"><item value="-1" label="Pagar"/><item value="1" label="Receber"/></parameter></prompt-parameters><level id="lvl_mn8nim" description="Principal"><container orientacao="V" tamanhoRelativo="100"><grid id="grd_mn8nin" multiplaSelecao="S" useNewGrid="S"><expression type="sql" data-source="MGEDS"><![CDATA[SELECT FIN.DTNEG,
	FIN.CODEMP,
	FIN.DTVENC,
	FIN.NUMNOTA,
	FIN.CODPARC,
	PAR.RAZAOSOCIAL,
	FIN.VLRDESDOB,
	FIN.CODTIPTIT,
	TIT.DESCRTIPTIT,
	FIN.CODNAT,
	NAT.DESCRNAT,
	FIN.DHBAIXA,
	FIN.VLRBAIXA,
	(CASE WHEN FIN.PROVISAO='S' THEN 'Provisões' ELSE 'Reais' END) AS PROVREAL,
	FIN.PROVISAO,
	FIN.DESDOBRAMENTO,
	(CASE WHEN FIN.ORIGEM = 'F' THEN 'FINANCEIRO' WHEN FIN.ORIGEM = 'E' THEN 'ESTOQUE' END) AS ORIGEM,
	CUS.DESCRCENCUS,
	FIN.CODCENCUS,
	V.VLRLIQUIDO
FROM TGFFIN FIN
	INNER JOIN TGFPAR PAR ON FIN.CODPARC = PAR.CODPARC
	INNER JOIN TGFTIT TIT ON FIN.CODTIPTIT = TIT.CODTIPTIT
	INNER JOIN TGFNAT NAT ON FIN.CODNAT = NAT.CODNAT
	INNER JOIN TSIEMP EMP ON FIN.CODEMP = EMP.CODEMP
	INNER JOIN VGFFIN V ON FIN.NUFIN = V.NUFIN
	LEFT JOIN TSICUS CUS ON FIN.CODCENCUS = CUS.CODCENCUS
WHERE FIN.DTVENC >= :P_PERIODO.INI
	AND FIN.DTVENC <= :P_PERIODO.FIN
	AND (:P_CODEMP IS NULL OR FIN.CODEMP = :P_CODEMP)
	AND FIN.DHBAIXA IS NULL
	AND FIN.RECDESP = :P_RECDESP
	AND FIN.CODTIPTIT NOT IN (34)
ORDER BY DTVENC , "PROVREAL", PAR.RAZAOSOCIAL]]></expression><metadata><field name="DTNEG" label="Dt. de Negociação" type="D" visible="true" useFooter="false"></field><field name="CODEMP" label="Empresa" type="I" visible="true" useFooter="false"></field><field name="DTVENC" label="Dt. de Vencimento" type="D" visible="true" useFooter="false"></field><field name="NUMNOTA" label="Nr. da Nota" type="I" visible="true" useFooter="false"></field><field name="CODPARC" label="Cód. Parceiro" type="I" visible="true" useFooter="false"></field><field name="RAZAOSOCIAL" label="Razão Social" type="S" visible="true" useFooter="false"></field><field name="VLRDESDOB" label="Vlr. Desdobramento" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"></field><field name="CODTIPTIT" label="Cód. Tip. Título" type="I" visible="true" useFooter="false"></field><field name="DESCRTIPTIT" label="Tipo de Título" type="S" visible="true" useFooter="false"></field><field name="CODNAT" label="Cód. Natureza" type="I" visible="true" useFooter="false"></field><field name="DESCRNAT" label="Natureza" type="S" visible="true" useFooter="false"></field><field name="DHBAIXA" label="Dt. da Baixa" type="D" visible="true" useFooter="false"></field><field name="VLRBAIXA" label="Vlr. da Baixa" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"></field><field name="PROVREAL" label="Tipo de Provisão" type="S" visible="true" useFooter="false"></field><field name="PROVISAO" label="Id. Provisão" type="S" visible="true" useFooter="false"></field><field name="DESDOBRAMENTO" label="Parcela" type="S" visible="true" useFooter="false"></field><field name="ORIGEM" label="Origem" type="S" visible="true" useFooter="false"></field><field name="DESCRCENCUS" label="Centro de Resultado" type="S" visible="true" useFooter="false"></field><field name="CODCENCUS" label="Cód. Centro de Resultado" type="I" visible="true" useFooter="false"></field><field name="VLRLIQUIDO" label="Vlr. Líquido" type="F" visible="true" useFooter="SUM" mask="R$ #.##0,00"></field></metadata></grid></container></level></gadget>