<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="expedicao_EMBALAGENS" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.9487171000000099"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    ITE.CODPROD AS COD,
    CASE
        WHEN EXP.CODPROD IS NOT NULL THEN EXP.DESCPROD
        ELSE PRO.DESCRPROD
    END AS DESCPRD,
    PEXP.CODCXPROD AS CODPROD,
    MAX(PRO1.DESCRPROD) AS DESCRPROD,
    SUM(PRO.PESOBRUTO) AS PESOBRUTO,
    SUM(PEXP.QTDA) AS QTDNEG,
    SUM(PEXP.PESOBRUT)
    + MAX(NVL((
        SELECT SUM(PLT.PESOPLL)
        FROM AD_TGSPESOEXPPLT PLT
        WHERE PLT.ID = EXP1.ID
         AND PLT.NRPALLET = PEXP.NRPALLET
    ),0)) AS PESOBRUTOPROD,
    SUM(NVL(PEXP.PESOBRUT,0)
        - NVL(PEXP.PESOEMB,0))
    + MAX(NVL((
        SELECT SUM(PLT.PESOPLL)
        FROM AD_TGSPESOEXPPLT PLT
        WHERE PLT.ID = EXP1.ID
          AND PLT.NRPALLET = PEXP.NRPALLET
    ),0)) AS PESOLIQ,
    PEXP.NRPALLET AS PO,
    CAB.AD_PACKAGE,
    COUNT(PEXP.IDCX) AS QTDCAIXA,
     'Pallet' AS PKG,
   MAX(NVL((
        SELECT SUM(PLT.M3)
        FROM AD_TGSPESOEXPPLT PLT
        WHERE PLT.ID = EXP1.ID
          AND PLT.NRPALLET = PEXP.NRPALLET
     ),0)) AS M3,
   PEXP. NRPALLET,
   MAX(CAB.QTDVOL) AS QTDPLLT,
   0 AS TOTAL_PKGS
FROM TGFCAB CAB

INNER JOIN TGFITE ITE
    ON ITE.NUNOTA = CAB.NUNOTA

INNER JOIN TGFPRO PRO
    ON PRO.CODPROD = ITE.CODPROD

LEFT JOIN AD_TGSDESCPROD EXP
    ON EXP.CODPROD = PRO.CODPROD
   AND EXP.CODPARC = CAB.CODPARC

INNER JOIN AD_TGSPESOEXP EXP1
    ON EXP1.NUNOTA = CAB.NUNOTA

INNER JOIN AD_TGSPESOEXPROD PEXP
    ON PEXP.ID = EXP1.ID

INNER JOIN TGFPRO PRO1
    ON PRO1.CODPROD = PEXP.CODCXPROD

WHERE CAB.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})
  AND CAB.AD_PACKAGE = 'P'

GROUP BY
    ITE.CODPROD,
    CASE
        WHEN EXP.CODPROD IS NOT NULL THEN EXP.DESCPROD
        ELSE PRO.DESCRPROD
    END,
    PEXP.CODCXPROD,
    PEXP.NRPALLET,
    CAB.AD_PACKAGE,
	PEXP. NRPALLET
UNION ALL
SELECT
    ITE.CODPROD AS COD,
    CASE
        WHEN EXP.CODPROD IS NOT NULL THEN EXP.DESCPROD
        ELSE PRO.DESCRPROD
    END AS DESCPRD,
    PEXP.CODCXPROD AS CODPROD,
    MAX(PRO1.DESCRPROD) AS DESCRPROD,
    SUM(PRO.PESOBRUTO) AS PESOBRUTO,
    SUM(PEXP.QTDA) AS QTDNEG,
    SUM(PEXP.PESOBRUT)
    + MAX(NVL((
        SELECT SUM(PLT.PESOPLL)
        FROM AD_TGSPESOEXPPLT PLT
        WHERE PLT.ID = EXP1.ID
         AND PLT.NRPALLET = PEXP.NRPALLET
    ),0)) AS PESOBRUTOPROD,
    SUM(NVL(PEXP.PESOBRUT,0)
        - NVL(PEXP.PESOEMB,0))
    + MAX(NVL((
        SELECT SUM(PLT.PESOPLL)
        FROM AD_TGSPESOEXPPLT PLT
        WHERE PLT.ID = EXP1.ID
          AND PLT.NRPALLET = PEXP.NRPALLET
    ),0)) AS PESOLIQ,
    MAX(CAB.AD_NRPO) AS PO,
    CAB.AD_PACKAGE,
    COUNT(PEXP.IDCX) AS QTDCAIXA,
    'BOX' AS PKG,
	MAX(PRO1.M3) AS M3,
    0 AS NRPALLET,
    0 AS QTDPLLT,
    (SELECT COUNT(DISTINCT P2.IDCX)
     FROM AD_TGSPESOEXP E2
     INNER JOIN AD_TGSPESOEXPROD P2 ON P2.ID = E2.ID
     WHERE E2.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})) AS TOTAL_PKGS
FROM TGFCAB CAB

INNER JOIN TGFITE ITE
    ON ITE.NUNOTA = CAB.NUNOTA

INNER JOIN TGFPRO PRO
    ON PRO.CODPROD = ITE.CODPROD

LEFT JOIN AD_TGSDESCPROD EXP
    ON EXP.CODPROD = PRO.CODPROD
   AND EXP.CODPARC = CAB.CODPARC

INNER JOIN AD_TGSPESOEXP EXP1
    ON EXP1.NUNOTA = CAB.NUNOTA

INNER JOIN AD_TGSPESOEXPROD PEXP
    ON PEXP.ID = EXP1.ID

INNER JOIN TGFPRO PRO1
    ON PRO1.CODPROD = PEXP.CODCXPROD
    AND PRO.CODPROD = PEXP.CODPROD
WHERE CAB.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})
  AND CAB.AD_PACKAGE = 'B'

GROUP BY
    ITE.CODPROD,
    CASE
        WHEN EXP.CODPROD IS NOT NULL THEN EXP.DESCPROD
        ELSE PRO.DESCRPROD
    END,
    PEXP.CODCXPROD,
    CAB.AD_PACKAGE
ORDER BY 9, 3]]>
	</queryString>
