<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Nota sem confirmar" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT CAB.NUNOTA,
	CAB.CHAVENFE,
	CAB.CODTIPOPER,
	(SELECT DISTINCT DESCROPER FROM TGFTOP T WHERE T.CODTIPOPER = CAB.CODTIPOPER) AS DESCROPER,
	TRUNC(CAB.DTENTSAI) AS DTENTSAI,
	CAB.CODPARC,
	U.NOMEUSU,
	PAR.RAZAOSOCIAL,
	(CASE WHEN (SELECT (SUM(NVL(QTDNEG,0))) FROM TGFITE I WHERE I.NUNOTA = CAB.NUNOTA) > (SELECT (SUM(NVL(QTDNEG,0))) FROM TGFITE IT WHERE IT.NUNOTA IN (SELECT DISTINCT C.NUNOTA FROM TGFCAB C WHERE C.CODTIPOPER IN (1202,1267) AND C.CHAVENFEREF = CAB.CHAVENFE)) THEN 'PENDENTE'
		WHEN (SELECT (SUM(NVL(QTDNEG,0))) FROM TGFITE I WHERE I.NUNOTA = CAB.NUNOTA) = (SELECT (SUM(NVL(QTDNEG,0))) FROM TGFITE IT WHERE IT.NUNOTA IN (SELECT DISTINCT C.NUNOTA FROM TGFCAB C WHERE C.CODTIPOPER IN (1202,1267) AND C.CHAVENFEREF = CAB.CHAVENFE)) THEN 'COMPLETO' ELSE 'PENDENTE' END) SITUACAO,
	SYSDATE - TRUNC(CAB.DTENTSAI) AS VENCTO
FROM TGFCAB CAB
	INNER JOIN TGFPAR PAR ON CAB.CODPARC = PAR.CODPARC
	INNER JOIN TSIUSU U ON (CAB.CODUSUINC = U.CODUSU)
WHERE CAB.CODTIPOPER IN (1108,2208,267)
	AND SYSDATE - TRUNC(CAB.DTENTSAI) >= 150
    AND (CASE WHEN (SELECT (SUM(NVL(QTDNEG,0))) FROM TGFITE I WHERE I.NUNOTA = CAB.NUNOTA) > (SELECT (SUM(NVL(QTDNEG,0))) FROM TGFITE IT WHERE IT.NUNOTA IN (SELECT DISTINCT C.NUNOTA FROM TGFCAB C WHERE C.CODTIPOPER IN (1202,1267) AND C.CHAVENFEREF = CAB.CHAVENFE)) THEN 'PENDENTE'
		WHEN (SELECT (SUM(NVL(QTDNEG,0))) FROM TGFITE I WHERE I.NUNOTA = CAB.NUNOTA) = (SELECT (SUM(NVL(QTDNEG,0))) FROM TGFITE IT WHERE IT.NUNOTA IN (SELECT DISTINCT C.NUNOTA FROM TGFCAB C WHERE C.CODTIPOPER IN (1202,1267) AND C.CHAVENFEREF = CAB.CHAVENFE)) THEN 'COMPLETO' ELSE 'PENDENTE' END) <> 'COMPLETO'
ORDER BY CAB.DTENTSAI,
	CAB.NUNOTA]]>
	</queryString>
	<field name="CHAVENFE" class="java.lang.String"/>
	<field name="DESCROPER" class="java.lang.String"/>
	<field name="NOMEUSU" class="java.lang.String"/>
	<field name="RAZAOSOCIAL" class="java.lang.String"/>
	<field name="SITUACAO" class="java.lang.String"/>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="CODTIPOPER" class="java.math.BigDecimal"/>
	<field name="CODPARC" class="java.math.BigDecimal"/>
	<field name="VENCTO" class="java.math.BigDecimal"/>
	<field name="DTENTSAI" class="java.sql.Timestamp"/>
	<title>
		<band height="46" splitType="Stretch">
			<staticText>
				<reportElement x="95" y="0" width="460" height="46"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="16"/>
				</textElement>
				<text><![CDATA[NOTAS DE REMESSA SEM RETORNO]]></text>
			</staticText>
			<image hAlign="Center" isUsingCache="true" isLazy="true">
				<reportElement x="0" y="0" width="95" height="46"/>
				<imageExpression class="java.lang.String"><![CDATA[$P{PDIR_MODELO} + "logo_spark.png"]]></imageExpression>
			</image>
		</band>
	</title>
	<columnHeader>
		<band height="23" splitType="Stretch">
			<rectangle>
				<reportElement x="0" y="0" width="553" height="23" backcolor="#CCCCCC"/>
