<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="INVOICE" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.7715610000000017"/>
	<property name="ireport.x" value="127"/>
	<property name="ireport.y" value="192"/>
	<property name="ireport.definition"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    CAB.NUNOTA,
	CAB.NUMNOTA,
	CAB.OBSERVACAO,
	EMP.RAZAOSOCIAL AS RAZAOEMP,
	'CNPJ: ' || Formatar_Cpf_Cnpj(EMP.CGC) AS CGC_EMP,
	'STREET' || ' ' || ENC.NOMEEND||', ' || EMP.NUMEND || ' - ' || BAIE.NOMEBAI AS ENDERECO_EMP,
	CIDE.NOMECID||', ' || UFSE.DESCRICAO || ' - ' || 'BRAZIL ' || EMP.CEP AS CIDADE_EMP,
	'PHONE: +55' || EMP.TELEFONE AS TELEFONE_EMP,
	'E-MAIL: pedidos@usinaspark.com.br' AS EMAIL_EMP,
	CAB.CODVEND,
	VEN.APELIDO,
	CAB.LOCALENTREGA,
	CAB.CODPARC,
	PAR.NOMEPARC,
	PAR.RAZAOSOCIAL,
	PAR.TELEFONE,
	CAB.PESO || ' KG' AS PESOLIQCAB,
	CAB.PESOBRUTO || ' KG' AS PESOBRUTCAB,
	PAR.FAX,
	PAR.CGC_CPF,
	0 AS OTHER,
	(CASE WHEN CAB.VLRSEG > 0 THEN CAB.VLRSEG / CAB.VLRMOEDA ELSE 0 END) AS INSURANCE,
	PAR.CEP,
	PAR.INSCESTADNAUF,
	CAB.AD_BUYERNAME,
	CAB.AD_BUYERCITY,
	CAB.AD_BUYERADDRESS,
	ENDE.TIPO || ' ' || ENDE.NOMEEND||', ' || PAR.NUMEND AS ENDERECO_PARCEIRO,
	BAI.NOMEBAI || ' ' || PAR.COMPLEMENTO AS BAIRRO_PARCEIRO,
	CID.NOMECID ||' / ' ||PAI.DESCRICAO AS PAIS,
	'E-mail: ' || PAR.EMAIL AS EMAIL_PARCEIRO,
	'Phone: ' || PAR.TELEFONE as TELEFONE_PARCEIRO,
	PAI.DESCRICAO AS PAIS_PARCEIRO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN PARD.RAZAOSOCIAL END) AS RAZAOSOCIAL_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN ENDD.TIPO || ' ' || ENDD.NOMEEND||', ' || PARD.NUMEND END) AS ENDERECO_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN BAID.NOMEBAI || ' ' || PARD.COMPLEMENTO END) AS BAIRRO_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN CIDD.NOMECID ||' / ' ||PAID.DESCRICAO END) AS PAIS_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN 'E-mail: ' || PARD.EMAIL END) AS EMAIL_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN 'Phone: ' || PARD.TELEFONE END) AS TELEFONE_DESTINTARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN PAID.DESCRICAO END) AS PAIS_DESTINATARIO2,
	ITE.SEQUENCIA,
	ITE.CODPROD,
    CASE WHEN EXP.CODPROD IS NOT NULL THEN EXP.DESCPROD  ELSE PRO.DESCRPROD END AS DESCRPROD,
	CASE WHEN EXP.HTS IS NOT NULL THEN EXP.HTS ELSE TO_NUMBER(PRO.NCM) END AS NCM,
    CASE WHEN EXP.HTS IS NOT NULL THEN 'S' ELSE 'N' END AS TEMHTS,
	ITE.QTDNEG,
	ITE.CODVOL,
	NVL(ROUND((	SELECT
		     NVL(SUM(PEXP.PESOBRUT),0)
              + MAX((SELECT NVL(SUM(PLT.PESOPLL),0)
                 FROM AD_TGSPESOEXPPLT PLT
                  WHERE PLT.ID = EXP.ID)
                   )
		FROM AD_TGSPESOEXP EXP
		INNER JOIN  AD_TGSPESOEXPROD PEXP
			ON PEXP.ID = EXP.ID
		WHERE EXP.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})
          AND PEXP.CODPROD = ITE.CODPROD

	)/ITE.QTDNEG,5),0)  AS PESOBRUTO,
	ITE.AD_PESOBRUTEXP  AS PESOTOT,
	ITE.VLRUNITMOE - (ITE.VLRDESCMOE / ITE.QTDNEG) AS VLRUNIT,
	ITE.VLRTOTMOE - ITE.VLRDESCMOE AS VLRTOT,
	(SELECT OPCAO FROM TDDOPC WHERE NUCAMPO = 9999990602 AND VALOR = CAB.AD_TRANSPORTE) AS TRANSPORTE,
    NVL((SELECT
		NVL(SUM(PEXP.PESOBRUT),0)
         + MAX((SELECT NVL(SUM(PLT.PESOPLL),0)
            FROM AD_TGSPESOEXPPLT PLT
             WHERE PLT.ID = EXP.ID)
              )
     FROM AD_TGSPESOEXP EXP
     INNER JOIN AD_TGSPESOEXPROD PEXP
     	ON PEXP.ID = EXP.ID
     WHERE EXP.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})
        AND PEXP.CODPROD = ITE.CODPROD
    ),0) AS PESOTOTAL,

	CAB.LOCALENTREGA,
	(SELECT OPCAO FROM TDDOPC WHERE NUCAMPO = 9999990609 AND VALOR = CAB.AD_INCOTERM) AS AD_INCOTERM,
	SYSDATE AS DTDIA,
	CAB.DTFATUR,
	CAB.NUMNOTA || '/' || TO_CHAR(CAB.DTFATUR,'YYYY') AS NUMINVOICE,
	SUBSTR(AD_NRINVOICE,0,(length(to_char(AD_NRINVOICE)))-4) || '/' || SUBSTR(AD_NRINVOICE,-4,4) AS NRINVOICE,
	CAB.VLRMOEDA,
	CASE WHEN CAB.TIPFRETE = 'S' THEN (CASE WHEN CAB.VLRFRETE > 0 THEN CAB.VLRFRETE / CAB.VLRMOEDA ELSE 0 END) ELSE 0 END AS VLRFRETEUSD,
	(SELECT SUM(ROUND(I.VLRTOTMOE - I.VLRDESCMOE, 2))
			FROM TGFITE I
			   , TGFCAB C
	WHERE I.NUNOTA = C.NUNOTA
		AND C.NUNOTA = CAB.NUNOTA)
		+
		 (CASE WHEN CAB.TIPFRETE = 'S' THEN CASE WHEN CAB.VLRFRETE > 0 THEN CAB.VLRFRETE / CAB.VLRMOEDA ELSE 0 END ELSE 0 END)
		+
		 (CASE WHEN CAB.VLRSEG > 0 THEN CAB.VLRSEG / CAB.VLRMOEDA ELSE 0 END) AS VLRTOTFRETE,
    CAB.AD_NRPO,
    CAB.MARCA

FROM TGFCAB CAB
	INNER JOIN TGFPAR PAR
         ON CAB.CODPARC = PAR.CODPARC

	INNER JOIN TSIEND ENDE
        ON PAR.CODEND = ENDE.CODEND

	INNER JOIN TSICID CID
        ON PAR.CODCID = CID.CODCID

	INNER JOIN TSIUFS UFS
         ON CID.UF = UFS.CODUF

	INNER JOIN TSIPAI PAI
        ON UFS.CODPAIS = PAI.CODPAIS

	INNER JOIN TSIBAI BAI
        ON PAR.CODBAI = BAI.CODBAI

	INNER JOIN TSIEMP EMP
        ON CAB.CODEMP = EMP.CODEMP

	INNER JOIN TSIEND ENC
        ON EMP.CODEND = ENC.CODEND

	INNER JOIN TSIBAI BAIE
        ON EMP.CODBAI = BAIE.CODBAI

	INNER JOIN TSICID CIDE
        ON EMP.CODCID = CIDE.CODCID

	INNER JOIN TSIUFS UFSE
        ON CIDE.UF = UFSE.CODUF

	INNER JOIN TGFVEN VEN
         ON CAB.CODVEND = VEN.CODVEND

	INNER JOIN TGFITE ITE
        ON CAB.NUNOTA = ITE.NUNOTA

	INNER JOIN TGFPRO PRO
         ON ITE.CODPROD = PRO.CODPROD

	INNER JOIN TGFPAR PARD
        ON CAB.CODPARCDEST = PARD.CODPARC

	INNER JOIN TSIEND ENDD
        ON PARD.CODEND = ENDD.CODEND

	INNER JOIN TSICID CIDD
        ON PARD.CODCID = CIDD.CODCID

	INNER JOIN TSIUFS UFSD
        ON CIDD.UF = UFSD.CODUF

	INNER JOIN TSIPAI PAID
        ON UFSD.CODPAIS = PAID.CODPAIS

	INNER JOIN TSIBAI BAID
        ON PARD.CODBAI = BAID.CODBAI

    LEFT JOIN AD_TGSDESCPROD EXP
        ON EXP.CODPROD = PRO.CODPROD
        AND EXP.CODPARC = CAB.CODPARC

WHERE CAB.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})

ORDER BY CAB.DTNEG
	  , CAB.NUNOTA
	  , CAB.CODEMP]]>
	</queryString>
