	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_IDIPROC" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PK_IDIATV" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT PROC.IDIPROC,
	IPA.QTDPRODUZIR,
	PRO.DESCRPROD,
	PROC.DHINC,
	IPA.NROLOTE,
	IPA.CODPRODPA,
	PROC.NUMPS,
	PROC.DTPREVENT,
	PRO.COMPLDESC,
	PRO.AD_OBSTECNICA,
	(SELECT LPA.AD_OBSPLANEJA FROM TPRLPA LPA WHERE LPA.CODPRODPA = IPA.CODPRODPA AND LPA.IDPROC = PROC.IDPROC) AS AD_OBSPLANEJA
FROM TPRIPROC PROC
	INNER JOIN TPRIPA IPA ON IPA.IDIPROC = PROC.IDIPROC
	INNER JOIN TGFPRO PRO ON PRO.CODPROD = IPA.CODPRODPA
WHERE NVL(PROC.AD_AGRUPADORIMP,PROC.IDIPROC) IN (SELECT NVL(PR.AD_AGRUPADORIMP,PR.IDIPROC)
													FROM TPRIPROC PR WHERE PR.IDIPROC= $P{PK_IDIPROC})
ORDER BY PROC.IDIPROC]]>
	</queryString>
	<field name="IDIPROC" class="java.math.BigDecimal"/>
	<field name="QTDPRODUZIR" class="java.math.BigDecimal"/>
	<field name="DESCRPROD" class="java.lang.String"/>
