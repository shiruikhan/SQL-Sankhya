<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="custom_report" pageWidth="841" pageHeight="595" orientation="Landscape" columnWidth="813" leftMargin="14" rightMargin="14" topMargin="22" bottomMargin="14">
	<property name="ireport.zoom" value="1.2100000000000013"/>
