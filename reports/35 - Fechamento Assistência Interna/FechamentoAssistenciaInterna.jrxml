<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  Nome do Script : FechamentoAssistenciaInterna
  Tipo           : Relatório Jasper (.jrxml)
  Grupo          : 35 - Fechamento Assistência Interna
  Descrição      : Pré-fechamento das O.S. de assistência técnica (AD_TGFASS)
                   por assistência responsável e período. É impresso ANTES da
                   emissão da nota de serviço — o usuário usa o total de cada
                   assistência para emitir o Nro. Único — e por isso NÃO depende
                   de AD_TGFASS.NUNOTA (gravado depois por
                   STP_GRAVANOTA_ASSISTENCIA). O NUNOTA aparece apenas como
                   coluna informativa (vazio enquanto a nota não foi vinculada).
                   Cabeçalho padrão com os dados da empresa 1 (Spark Eletrônica
                   — TSIEMP) e logo; um grupo por assistência responsável
                   (CODPARCASS) com subtotal do VLRCONSERTO e quantidade de
                   O.S.; total geral no final.
                   Colunas: NUMOS, SNENTRADA, DTCONCLUSAO, STATUS, DEFEITO,
                   NUNOTA (informativo) e VLRCONSERTO. STATUS e DEFEITO são
                   campos de lista e são exibidos pelo texto da opção
                   (TDDCAM/TDDOPC), não pelo código.

  Parâmetros     : P_CODPARCASS — assistência responsável (AD_TGFASS.CODPARCASS)
                                  (opcional). Em branco, lista todas.
                   P_DTINI      — data de conclusão inicial (opcional)
                   P_DTFIN      — data de conclusão final (opcional)
                   P_STATUS     — código do STATUS da O.S. (opcional)

  Tabelas        : AD_TGFASS : O.S. de assistência (leitura)
                   TGFPAR    : nome da assistência responsável
                   TSIEMP / TSIEND / TSIBAI / TSICID / TSIUFS : dados da empresa 1
                   TDDCAM / TDDOPC : opções dos campos de lista STATUS e DEFEITO

  Empresa        : Spark Eletrônica
  Autor          : Silvio Vieira
  Cargo          : Analista de Sistemas Sênior
  Data de Criação: 29/09/2026
  Última Revisão : Setembro/2026 — Refatoração: seleção por assistência/período
                   em vez de NUNOTA vinculado

  Observações    : - O filtro de período usa DTCONCLUSAO; O.S. sem data de
                     conclusão não entram (fechamento considera só concluídas).
                     Sem P_DTINI/P_DTFIN, o filtro de datas é ignorado.
                   - A tradução de STATUS/DEFEITO localiza o NUCAMPO em TDDCAM
                     (NOMETAB = 'AD_TGFASS' e NOMECAMPO), então acompanha o
                     cadastro do campo. Código sem opção cadastrada é exibido
                     como está (fallback).
                   - A empresa do cabeçalho é fixa (CODEMP = 1).
                   - O.S. sem CODPARCASS caem no grupo "SEM ASSISTÊNCIA".
  ==============================================================================
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FechamentoAssistenciaInterna" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoDataSection">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="P_CODPARCASS" class="java.math.BigDecimal">
		<property name="NOMETABELA" value="TGFPAR"/>
		<parameterDescription><![CDATA[Assistência responsável (opcional; em branco lista todas)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DTINI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data de conclusão inicial (opcional)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DTFIN" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Data de conclusão final (opcional)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_STATUS" class="java.lang.String">
		<parameterDescription><![CDATA[Status da O.S. (opcional; em branco lista todos os status)]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT NVL(ASS.CODPARCASS, 0) AS CODPARCASS,
    NVL(PAR.NOMEPARC, 'SEM ASSISTÊNCIA') AS NOMEPARCASS,
    ASS.NUMOS,
    ASS.SNENTRADA,
    ASS.DTCONCLUSAO,
    NVL((SELECT MAX(OPC.OPCAO)
           FROM TDDOPC OPC
          INNER JOIN TDDCAM CAM ON CAM.NUCAMPO = OPC.NUCAMPO
          WHERE CAM.NOMETAB   = 'AD_TGFASS'
            AND CAM.NOMECAMPO = 'STATUS'
            AND OPC.VALOR     = ASS.STATUS), ASS.STATUS) AS STATUS,
    NVL((SELECT MAX(OPC.OPCAO)
           FROM TDDOPC OPC
          INNER JOIN TDDCAM CAM ON CAM.NUCAMPO = OPC.NUCAMPO
          WHERE CAM.NOMETAB   = 'AD_TGFASS'
            AND CAM.NOMECAMPO = 'DEFEITO'
            AND OPC.VALOR     = ASS.DEFEITO), ASS.DEFEITO) AS DEFEITO,
    ASS.NUNOTA,
    ASS.VLRCONSERTO,
    EMP.RAZAOSOCIAL AS EMP_RAZAO,
    EMPEDN.NOMEEND || ', ' || EMP.NUMEND
        || CASE WHEN EMP.COMPLEMENTO IS NOT NULL THEN ' - ' || EMP.COMPLEMENTO END
        || CASE WHEN EMPBAI.NOMEBAI IS NOT NULL THEN ' - ' || EMPBAI.NOMEBAI END AS EMP_ENDERECO,
    EMPCID.NOMECID || '/' || EMPUFS.UF || ' - CEP ' || EMP.CEP AS EMP_CIDADE,
    'CNPJ: ' ||
    CASE
        WHEN LENGTH(REGEXP_REPLACE(EMP.CGC, '[^0-9]', '')) = 14 THEN
            REGEXP_REPLACE(REGEXP_REPLACE(EMP.CGC, '[^0-9]', ''),
                '^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$', '\1.\2.\3/\4-\5')
        ELSE EMP.CGC
    END
    || '   IE: ' || EMP.INSCESTAD
    || '   Fone: ' || EMP.TELEFONE AS EMP_DOC
FROM AD_TGFASS ASS
    LEFT JOIN TGFPAR PAR ON PAR.CODPARC = ASS.CODPARCASS
    INNER JOIN TSIEMP EMP ON EMP.CODEMP = 1
    LEFT JOIN TSIEND EMPEDN ON EMPEDN.CODEND = EMP.CODEND
    LEFT JOIN TSIBAI EMPBAI ON EMPBAI.CODBAI = EMP.CODBAI
    LEFT JOIN TSICID EMPCID ON EMPCID.CODCID = EMP.CODCID
    LEFT JOIN TSIUFS EMPUFS ON EMPUFS.CODUF = EMPCID.UF
WHERE DECODE(ASS.CODPARCASS, NVL($P{P_CODPARCASS}, ASS.CODPARCASS), 1, 0) = 1
  AND DECODE(ASS.STATUS, NVL($P{P_STATUS}, ASS.STATUS), 1, 0) = 1
  AND ASS.DTCONCLUSAO >= NVL($P{P_DTINI}, ASS.DTCONCLUSAO)
  AND ASS.DTCONCLUSAO < NVL($P{P_DTFIN}, ASS.DTCONCLUSAO) + 1
ORDER BY NOMEPARCASS, CODPARCASS, ASS.NUMOS]]>
	</queryString>
	<field name="CODPARCASS" class="java.math.BigDecimal"/>
	<field name="NOMEPARCASS" class="java.lang.String"/>
	<field name="NUMOS" class="java.math.BigDecimal"/>
	<field name="SNENTRADA" class="java.lang.String"/>
	<field name="DTCONCLUSAO" class="java.sql.Timestamp"/>
	<field name="STATUS" class="java.lang.String"/>
	<field name="DEFEITO" class="java.lang.String"/>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="VLRCONSERTO" class="java.lang.Double"/>
	<field name="EMP_RAZAO" class="java.lang.String"/>
	<field name="EMP_ENDERECO" class="java.lang.String"/>
	<field name="EMP_CIDADE" class="java.lang.String"/>
	<field name="EMP_DOC" class="java.lang.String"/>
	<variable name="SUB_CONSERTO" class="java.lang.Double" resetType="Group" resetGroup="CODPARCASS" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRCONSERTO}]]></variableExpression>
	</variable>
	<variable name="SUB_QTD_OS" class="java.lang.Integer" resetType="Group" resetGroup="CODPARCASS" calculation="Count">
		<variableExpression><![CDATA[$F{NUMOS}]]></variableExpression>
	</variable>
	<variable name="TOTAL_CONSERTO" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRCONSERTO}]]></variableExpression>
	</variable>
	<variable name="TOTAL_QTD_OS" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{NUMOS}]]></variableExpression>
	</variable>
