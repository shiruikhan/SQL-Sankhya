<gadget>
  <prompt-parameters>
    <parameter id="P_PERIODO" description="Período" metadata="datePeriod" required="true" keep-last="false" keep-date="false" order="0"/>
    <parameter id="P_CODPARC" description="Parceiro Assistência" metadata="entity:Parceiro@CODPARC" required="false" keep-last="false" keep-date="false" order="1"/>
  </prompt-parameters>
  <level id="lvl_a309pwv" description="Principal">
    <container orientacao="H" tamanhoRelativo="100">
      <container orientacao="V" tamanhoRelativo="50">
        <grid id="grd_a309pww" multiplaSelecao="S" useNewGrid="S">
          <expression type="sql" data-source="MGEDS"><![CDATA[SELECT A.T_CODPROD,    A.T_DESCRPROD,    COUNT(A.NUMOS) AS TOTALFROM AD_SPKCAE AWHERE (:P_PERIODO.INI IS NULL OR A.DTCONCLUSAO >= :P_PERIODO.INI)    AND (:P_PERIODO.FIN IS NULL OR A.DTCONCLUSAO <= :P_PERIODO.FIN)    AND (:P_CODPARC IS NULL OR A.CODPARC = :P_CODPARC)GROUP BY A.T_CODPROD, A.T_DESCRPRODORDER BY A.T_CODPROD]]></expression>
          <metadata>
            <field name="T_CODPROD" label="Cód. Produto" type="I" visible="true" useFooter="false"/>
            <field name="T_DESCRPROD" label="Produto" type="S" visible="true" useFooter="false"/>
            <field name="TOTAL" label="Total" type="I" visible="true" useFooter="SUM"/>
          </metadata>
        </grid>
      </container>
      <container orientacao="V" tamanhoRelativo="50">
        <grid id="grd_a309pwx" multiplaSelecao="S" useNewGrid="S">
          <expression type="sql" data-source="MGEDS"><![CDATA[SELECT IA.CODPROD,    P.DESCRPROD,    SUM(IA.QTDMOV) AS TOTALFROM AD_SPKICAE IA    INNER JOIN TGFPRO P ON IA.CODPROD = P.CODPROD    INNER JOIN AD_SPKCAE A ON IA.NUMOS = A.NUMOSWHERE (:P_PERIODO.INI IS NULL OR A.DTCONCLUSAO >= :P_PERIODO.INI)    AND (:P_PERIODO.FIN IS NULL OR A.DTCONCLUSAO <= :P_PERIODO.FIN)    AND (:P_CODPARC IS NULL OR A.CODPARC = :P_CODPARC)GROUP BY IA.CODPROD, P.DESCRPROD]]></expression>
          <metadata>
            <field name="CODPROD" label="Cód. Produto" type="I" visible="true" useFooter="false"/>
            <field name="DESCRPROD" label="Componente" type="S" visible="true" useFooter="false"/>
            <field name="TOTAL" label="Total" type="I" visible="true" useFooter="SUM"/>
          </metadata>
        </grid>
      </container>
    </container>
  </level>
</gadget>