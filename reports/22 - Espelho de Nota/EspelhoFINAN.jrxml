	<detail>
		<band height="15">
			<textField>
				<reportElement x="1" y="0" width="60" height="15"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{NUMNOTA}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="61" y="0" width="28" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{CODEMP}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="89" y="0" width="38" height="15"/>
