<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EtiquetaSerie" language="groovy" columnCount="2" printOrder="Horizontal" pageWidth="310" pageHeight="123" orientation="Landscape" columnWidth="140" columnSpacing="15" leftMargin="8" rightMargin="7" topMargin="4" bottomMargin="4">
	<property name="ireport.zoom" value="6.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT PRO.CODPROD,
	SER.SERIE,
	PRO.AD_REFINTERNA,
	PRO.COMPLDESC,
	PRO.AD_ETIQUETAPROD,
	PRO.REFERENCIA
FROM TGFSER SER
	INNER JOIN TGFPRO PRO ON PRO.CODPROD = SER.CODPROD
WHERE SER.NUNOTA = $P{PK_NUNOTA}]]>
	</queryString>
