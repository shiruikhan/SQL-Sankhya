<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="expedicao_EMBALAGENS" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.5937424601000045"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT PRO.CODPROD,
	PRO.DESCRPROD,
	PRO.PESOBRUTO,
	SUM(PROD.PESOBRUTO) AS PESOBRUTOPROD,
    SUM(V.PESOBRUTO) AS PESO,
    COUNT(DISTINCT IDCAIXA) AS QTDCAIXA ,
    SUM(V.M3) AS M3TOT,
    PRO.PESOBRUTO * COUNT(DISTINCT IDCAIXA) AS PESOTOTCAIXA,
    (PRO.PESOBRUTO * COUNT(DISTINCT IDCAIXA)) + SUM(V.PESOBRUTO) AS PESOTOTAL,
    COUNT(DISTINCT IDCAIXA) * SUM(PROD.M3) AS M3,
	(CASE WHEN CAB.AD_PACKAGE = 'B' THEN 'Box' WHEN CAB.AD_PACKAGE = 'P' THEN 'Pallet' END) AS PKG
FROM AD_EMBPED V
	INNER JOIN TGFPRO PRO ON V.CODPRODEMB = PRO.CODPROD
	INNER JOIN TGFPRO PROD ON V.CODPROD = PROD.CODPROD
	LEFT JOIN TGFCAB CAB ON V.NUNOTA = CAB.NUNOTA
WHERE V.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})
GROUP BY PRO.CODPROD,
	PRO.DESCRPROD,
	PRO.M3,
	PRO.PESOBRUTO,
	CAB.AD_PACKAGE]]>
	</queryString>
