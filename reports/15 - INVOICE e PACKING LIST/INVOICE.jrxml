<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="INVOICE" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="4.287177620000003"/>
	<property name="ireport.x" value="926"/>
	<property name="ireport.y" value="1624"/>
	<property name="ireport.definition"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT CAB.NUNOTA,
	CAB.NUMNOTA,
	CAB.OBSERVACAO,
	EMP.RAZAOSOCIAL AS RAZAOEMP,
	'CNPJ: ' || Formatar_Cpf_Cnpj(EMP.CGC) AS CGC_EMP,
	'STREET' || ' ' || ENC.NOMEEND||', ' || EMP.NUMEND || ' - ' || BAIE.NOMEBAI AS ENDERECO_EMP,
	CIDE.NOMECID||', ' || UFSE.DESCRICAO || ' - ' || 'BRAZIL ' || EMP.CEP AS CIDADE_EMP,
	'PHONE: +55' || EMP.TELEFONE AS TELEFONE_EMP,
	'E-MAIL: pedidos@usinaspark.com.br' AS EMAIL_EMP,
	CAB.CODVEND,
	VEN.APELIDO,
	CAB.CODPARC,
	PAR.NOMEPARC,
	PAR.RAZAOSOCIAL,
	PAR.TELEFONE,
	CAB.PESO || ' KG' AS PESOLIQCAB,
	CAB.PESOBRUTO || ' KG' AS PESOBRUTCAB,
	PAR.FAX,
	PAR.CGC_CPF,
	(CASE WHEN CAB.VLROUTROS > 0 THEN CAB.VLROUTROS / CAB.VLRMOEDA ELSE 0 END) AS OTHER,
	(CASE WHEN CAB.VLRSEG > 0 THEN CAB.VLRSEG / CAB.VLRMOEDA ELSE 0 END) AS INSURANCE,
	PAR.CEP,
	PAR.INSCESTADNAUF,
	CAB.AD_BUYERNAME,
	CAB.AD_BUYERCITY,
	CAB.AD_BUYERADDRESS,
	ENDE.TIPO || ' ' || ENDE.NOMEEND||', ' || PAR.NUMEND AS ENDERECO_PARCEIRO,
	BAI.NOMEBAI || ' ' || PAR.COMPLEMENTO AS BAIRRO_PARCEIRO,
	CID.NOMECID ||' / ' ||PAI.DESCRICAO AS PAIS,
	'E-mail: ' || PAR.EMAIL AS EMAIL_PARCEIRO,
	'Phone: ' || PAR.TELEFONE as TELEFONE_PARCEIRO,
	PAI.DESCRICAO AS PAIS_PARCEIRO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN PARD.RAZAOSOCIAL END) AS RAZAOSOCIAL_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN ENDD.TIPO || ' ' || ENDD.NOMEEND||', ' || PARD.NUMEND END) AS ENDERECO_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN BAID.NOMEBAI || ' ' || PARD.COMPLEMENTO END) AS BAIRRO_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN CIDD.NOMECID ||' / ' ||PAID.DESCRICAO END) AS PAIS_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN 'E-mail: ' || PARD.EMAIL END) AS EMAIL_DESTINATARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN 'Phone: ' || PARD.TELEFONE END) AS TELEFONE_DESTINTARIO,
	(CASE WHEN PARD.CODPARC = 0 THEN NULL WHEN PARD.CODPARC > 0 THEN PAID.DESCRICAO END) AS PAIS_DESTINATARIO2,
	ITE.SEQUENCIA,
	ITE.CODPROD,
	PRO.DESCRPROD,
	PRO.NCM,
	ITE.QTDNEG,
	ITE.CODVOL,
	PRO.PESOBRUTO,
	PRO.PESOBRUTO * ITE.QTDNEG AS PESOTOT,
	ITE.VLRUNITMOE - (ITE.VLRDESCMOE / ITE.QTDNEG) AS VLRUNIT,
	ITE.VLRTOTMOE - ITE.VLRDESCMOE AS VLRTOT,
	(SELECT OPCAO FROM TDDOPC WHERE NUCAMPO = 9999990602 AND VALOR = CAB.AD_TRANSPORTE) AS TRANSPORTE,
	(SELECT SUM(PESOTOTAL) FROM (SELECT (PRO.PESOBRUTO * COUNT(DISTINCT IDCAIXA)) + SUM(V.PESOBRUTO) AS PESOTOTAL FROM AD_EMBPED V, TGFPRO PRO, TGFPRO PROD WHERE V.CODPRODEMB = PRO.CODPROD AND V.CODPROD = PROD.CODPROD AND V.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA}) GROUP BY PRO.CODPROD , PRO.DESCRPROD, PRO.M3, PRO.PESOBRUTO) V) AS PESOTOTAL,
	CAB.LOCALENTREGA,
	(SELECT OPCAO FROM TDDOPC WHERE NUCAMPO = 9999990609 AND VALOR = CAB.AD_INCOTERM) AS AD_INCOTERM,
	SYSDATE AS DTDIA,
	CAB.DTFATUR,
	CAB.NUMNOTA || '/' || TO_CHAR(CAB.DTFATUR,'YYYY') AS NUMINVOICE,
	SUBSTR(AD_NRINVOICE,0,(length(to_char(AD_NRINVOICE)))-4) || '/' || SUBSTR(AD_NRINVOICE,-4,4) AS NRINVOICE,
	CAB.VLRMOEDA,
	(CASE WHEN CAB.VLRFRETE > 0 THEN CAB.VLRFRETE / CAB.VLRMOEDA ELSE 0 END) AS VLRFRETEUSD,
	(SELECT SUM(I.VLRTOTMOE - I.VLRDESCMOE - I.VLRREPRED) FROM TGFITE I , TGFCAB C WHERE I.NUNOTA = C.NUNOTA AND C.NUNOTA = CAB.NUNOTA) + (CASE WHEN CAB.VLRFRETE > 0 THEN CAB.VLRFRETE / CAB.VLRMOEDA ELSE 0 END) + (CASE WHEN CAB.VLRSEG > 0 THEN CAB.VLRSEG / CAB.VLRMOEDA ELSE 0 END) + (CASE WHEN CAB.VLROUTROS > 0 THEN CAB.VLROUTROS / CAB.VLRMOEDA ELSE 0 END) AS VLRTOTFRETE
FROM TGFCAB CAB
	INNER JOIN TGFPAR PAR ON CAB.CODPARC = PAR.CODPARC
	INNER JOIN TSIEND ENDE ON PAR.CODEND = ENDE.CODEND
	INNER JOIN TSICID CID ON PAR.CODCID = CID.CODCID
	INNER JOIN TSIUFS UFS ON CID.UF = UFS.CODUF
	INNER JOIN TSIPAI PAI ON UFS.CODPAIS = PAI.CODPAIS
	INNER JOIN TSIBAI BAI ON PAR.CODBAI = BAI.CODBAI
	INNER JOIN TSIEMP EMP ON CAB.CODEMP = EMP.CODEMP
	INNER JOIN TSIEND ENC ON EMP.CODEND = ENC.CODEND
	INNER JOIN TSIBAI BAIE ON EMP.CODBAI = BAIE.CODBAI
	INNER JOIN TSICID CIDE ON EMP.CODCID = CIDE.CODCID
	INNER JOIN TSIUFS UFSE ON CIDE.UF = UFSE.CODUF
	INNER JOIN TGFVEN VEN ON CAB.CODVEND = VEN.CODVEND
	INNER JOIN TGFITE ITE ON CAB.NUNOTA = ITE.NUNOTA
	INNER JOIN TGFPRO PRO ON ITE.CODPROD = PRO.CODPROD
	INNER JOIN TGFPAR PARD ON CAB.CODPARCDEST = PARD.CODPARC
	INNER JOIN TSIEND ENDD ON PARD.CODEND = ENDD.CODEND
	INNER JOIN TSICID CIDD ON PARD.CODCID = CIDD.CODCID
	INNER JOIN TSIUFS UFSD ON CIDD.UF = UFSD.CODUF
	INNER JOIN TSIPAI PAID ON UFSD.CODPAIS = PAID.CODPAIS
	INNER JOIN TSIBAI BAID ON PARD.CODBAI = BAID.CODBAI
WHERE CAB.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})
ORDER BY CAB.DTNEG, CAB.NUNOTA, CAB.CODEMP]]>
	</queryString>
	<field name="QTDNEG" class="java.math.BigDecimal"/>
	<field name="PESOBRUTO" class="java.math.BigDecimal"/>
	<field name="VLRMOEDA" class="java.math.BigDecimal"/>
	<field name="OBSERVACAO" class="java.lang.String"/>
