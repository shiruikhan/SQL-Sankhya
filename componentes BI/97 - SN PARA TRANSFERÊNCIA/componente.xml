<gadget>
  <prompt-parameters>
    <parameter id="P_PERIODO" description="Período" metadata="datePeriod" required="true" keep-last="false" keep-date="false" order="0"/>
  </prompt-parameters>
  <level id="lvl_aisttym" description="Principal">
    <container orientacao="V" tamanhoRelativo="100">
      <grid id="grd_aisttyn" useNewGrid="S">
        <expression type="sql" data-source="MGEDS"><![CDATA[SELECT CAB.CODEMP,	EMP.NOMEFANTASIA AS EMPFATURAMENTO,    SER.NUNOTA,    CAB.NUMNOTA AS NPEDIDO,    CAB.DTNEG,	CAB.CODPARC,    PAR.NOMEPARC,    CAB.DTPREVENT,    SER.CODPROD,    SER.SEQUENCIA,    SER.SERIE    FROM TGFSER SER     INNER JOIN TGFCAB CAB ON CAB.NUNOTA = SER.NUNOTA    INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC    INNER JOIN TSIEMP EMP ON CAB.CODEMP = EMP.CODEMP    WHERE TRUNC(CAB.DTPREVENT) >= :P_PERIODO.INI AND TRUNC(CAB.DTPREVENT) <= :P_PERIODO.FIN	AND CAB.PENDENTE = 'S'	AND CAB.CODEMP = 2]]></expression>
        <metadata>
          <field name="CODEMP" label="Cod. Empresa" type="I" visible="true" useFooter="false"/>
          <field name="EMPFATURAMENTO" label="Empresa" type="S" visible="true" useFooter="false"/>
          <field name="NUNOTA" label="Nr. Único" type="I" visible="true" useFooter="false"/>
          <field name="NPEDIDO" label="Nr. Pedido" type="I" visible="true" useFooter="false"/>
          <field name="DTNEG" label="Dt. Negociação" type="D" visible="true" useFooter="false"/>
          <field name="CODPARC" label="Cod. Parceiro" type="I" visible="true" useFooter="false"/>
          <field name="NOMEPARC" label="Parceiro" type="S" visible="true" useFooter="false"/>
          <field name="DTPREVENT" label="Prev. de Entrega" type="D" visible="true" useFooter="false"/>
          <field name="CODPROD" label="Cod. Produto" type="I" visible="true" useFooter="false"/>
          <field name="SEQUENCIA" label="Sequência" type="I" visible="true" useFooter="false"/>
          <field name="SERIE" label="Série" type="S" visible="true" useFooter="false"/>
        </metadata>
        <on-click-launcher resource-id="br.com.sankhya.com.mov.CentralNotas">
          <NUNOTA>$NUNOTA</NUNOTA>
        </on-click-launcher>
      </grid>
    </container>
  </level>
</gadget>