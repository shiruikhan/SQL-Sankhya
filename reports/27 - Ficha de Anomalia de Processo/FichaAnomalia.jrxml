<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  Nome do Script : FichaAnomalia
  Tipo           : Relatório Jasper (.jrxml)
  Grupo          : 27 - Ficha de Anomalia de Processo
  Descrição      : Ficha impressa de anomalia de processo produtivo, baseada na
                   tabela customizada AD_TGFFTA. Estrutura em seções:
                   identificação, indicador/anomalia, contenção (solução
                   imediata), análise de causa pelos 5 Porquês, ação corretiva,
                   verificação da eficácia, aprovação e registro fotográfico.
                   Imprime uma ficha por NUFTA.

  Empresa        : Spark Eletrônica
  Autor          : Silvio Vieira
  Cargo          : Analista de Sistemas Sênior
  Data de Criação: 21/05/2026
  Última Revisão : Maio/2026 — Criação do relatório
  ==============================================================================
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FichaAnomalia" language="groovy" pageWidth="595" pageHeight="842" columnWidth="539" leftMargin="28" rightMargin="28" topMargin="20" bottomMargin="20" isSummaryNewPage="true">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUFTA" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[Nr. da Anomalia]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT  FTA.NUFTA
       ,TO_CHAR(FTA.DTFTA, 'DD/MM/YYYY')                   AS DTFTA
       ,NVL(DEP.DESCRDEP, '-')                             AS SETOR_AFETADO
       ,NVL(FUN.NOMEFUNC, '-')                             AS RESP_INDICADOR
       ,CASE FTA.INDICADOR
             WHEN 'PRD' THEN 'Produção'
             WHEN 'RTB' THEN 'Retrabalho'
             WHEN 'OTR' THEN 'Outro'
             WHEN 'QLD' THEN 'Qualidade'
             ELSE NVL(FTA.INDICADOR, '-')
        END                                                AS INDICADOR
       ,NVL(FTA.INDICADORORT, '-')                         AS INDICADORORT
       ,FTA.META                                           AS META
       ,FTA.RESOBTIDO                                      AS RESOBTIDO
       ,DBMS_LOB.SUBSTR(FTA.DESCOANOM, 4000, 1)            AS DESCOANOM
       ,DBMS_LOB.SUBSTR(FTA.CONTENCAO, 4000, 1)            AS CONTENCAO
       ,NVL(R2.NOMEFUNC, '-')                              AS RESP_CONT
       ,TO_CHAR(FTA.CONTPRAZO, 'DD/MM/YYYY')               AS CONTPRAZO
       ,NVL(FTA.PROBLEMA, '-')                             AS PROBLEMA
       ,NVL(DEPR.DESCRDEP, '-')                            AS SETOR_CAUSADOR
       ,NVL(FTA.PORQUE1, '-')                              AS PORQUE1
       ,NVL(FTA.PORQUE2, '-')                              AS PORQUE2
       ,NVL(FTA.PORQUE3, '-')                              AS PORQUE3
       ,NVL(FTA.PORQUE4, '-')                              AS PORQUE4
       ,NVL(FTA.PORQUE5, '-')                              AS PORQUE5
       ,DBMS_LOB.SUBSTR(FTA.CAUSARAIZ, 4000, 1)            AS CAUSARAIZ
       ,DBMS_LOB.SUBSTR(FTA.ACAOCORRET, 4000, 1)           AS ACAOCORRET
       ,CASE FTA.TIPOACAO
             WHEN '1' THEN 'Criar padrão operacional'
             WHEN '2' THEN 'Revisar padrão'
             WHEN '3' THEN 'Treinar equipe'
             WHEN '4' THEN 'Ajuste de processo'
             WHEN '5' THEN 'Manutenção'
             WHEN '6' THEN 'Alteração de fornecedor/material'
             WHEN '7' THEN 'Alteração de maquinário'
             ELSE NVL(FTA.TIPOACAO, '-')
        END                                                AS TIPOACAO
       ,NVL(R3.NOMEFUNC, '-')                              AS RESP_ACAO
       ,TO_CHAR(FTA.ACAOPRAZO, 'DD/MM/YYYY')               AS ACAOPRAZO
       ,TO_CHAR(FTA.DTVERIFICA, 'DD/MM/YYYY')              AS DTVERIFICA
       ,CASE FTA.VERIFICACAO
             WHEN '1' THEN 'A anomalia não voltou'
             WHEN '2' THEN 'Voltou parcialmente'
             WHEN '3' THEN 'Voltou totalmente'
             ELSE NVL(FTA.VERIFICACAO, '-')
        END                                                AS VERIFICACAO
       ,DBMS_LOB.SUBSTR(FTA.CONCLUSAO, 4000, 1)            AS CONCLUSAO
       ,CASE FTA.FINALIZACAO
             WHEN 'E' THEN 'Encerrar FTA'
             WHEN 'R' THEN 'Reabrir análise'
             ELSE NVL(FTA.FINALIZACAO, '-')
        END                                                AS FINALIZACAO
       ,NVL(APR.NOMEFUNC, '-')                             AS APROVADOR
       ,FTA.IMG1                                           AS IMG1
       ,FTA.IMG2                                           AS IMG2
  FROM AD_TGFFTA FTA
  LEFT JOIN TFPDEP DEP  ON FTA.CODDEP     = DEP.CODDEP
  LEFT JOIN TFPDEP DEPR ON FTA.CODDEPRESP = DEPR.CODDEP
  LEFT JOIN TFPFUN FUN  ON FTA.CODFUNC    = FUN.CODFUNC
  LEFT JOIN TFPFUN R2   ON FTA.RESP2      = R2.CODFUNC
  LEFT JOIN TFPFUN R3   ON FTA.RESP3      = R3.CODFUNC
  LEFT JOIN TFPFUN APR  ON FTA.APROVADOR  = APR.CODFUNC
 WHERE FTA.NUFTA = $P{PK_NUFTA}]]>
	</queryString>
