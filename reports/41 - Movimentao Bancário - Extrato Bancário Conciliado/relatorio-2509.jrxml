				<textFieldExpression class="java.lang.String"><![CDATA[($F{Debito_1} == null || $F{Debito_1}.doubleValue() == 0) ? "-" : new java.text.DecimalFormat("R$ #,##0.00", new java.text.DecimalFormatSymbols(new java.util.Locale("pt", "BR"))).format($F{Debito_1})]]></textFieldExpression>
