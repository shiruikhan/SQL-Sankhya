<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  Nome do Script : FechamentoAssistencia
  Tipo           : Relatório Jasper (.jrxml)
  Grupo          : 34 - Fechamento Assistência
  Descrição      : Lista as O.S. de assistência técnica (AD_SPKCAE) vinculadas a
                   um título financeiro gerado por STP_INCFINASSIST_SPARK.
                   Cabeçalho com os dados do parceiro prestador (código, razão
                   social, CNPJ/CPF) e data de emissão; detalhe com NUMOS,
                   SNENTRADA, DTCONCLUSAO, VLRCONSERTO e NUFIN; total do
                   VLRCONSERTO no final.

  Parâmetro      : PK_NUFIN — NUFIN do título gerado (marcador gravado em
                   AD_SPKCAE.NUFIN). Um relatório por título/parceiro; também
                   serve para reimprimir fechamentos antigos.

  Empresa        : Spark Eletrônica
  Autor          : Silvio Vieira
  Cargo          : Analista de Sistemas Sênior
  Data de Criação: 29/09/2026
  Última Revisão : Setembro/2026 — Criação
  ==============================================================================
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FechamentoAssistencia" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PK_NUFIN" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT CAE.NUMOS,
    CAE.SNENTRADA,
    CAE.DTCONCLUSAO,
    CAE.VLRCONSERTO,
    CAE.NUFIN,
    CAE.CODPARC,
    PAR.RAZAOSOCIAL,
    CASE
        WHEN LENGTH(REGEXP_REPLACE(PAR.CGC_CPF, '[^0-9]', '')) = 14 THEN
            REGEXP_REPLACE(REGEXP_REPLACE(PAR.CGC_CPF, '[^0-9]', ''),
                '^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$', '\1.\2.\3/\4-\5')
        WHEN LENGTH(REGEXP_REPLACE(PAR.CGC_CPF, '[^0-9]', '')) = 11 THEN
            REGEXP_REPLACE(REGEXP_REPLACE(PAR.CGC_CPF, '[^0-9]', ''),
                '^(\d{3})(\d{3})(\d{3})(\d{2})$', '\1.\2.\3-\4')
        ELSE PAR.CGC_CPF
    END AS CGC_CPF
FROM AD_SPKCAE CAE
    JOIN TGFPAR PAR ON PAR.CODPARC = CAE.CODPARC
WHERE CAE.NUFIN = $P{PK_NUFIN}
ORDER BY CAE.DTCONCLUSAO, CAE.NUMOS]]>
	</queryString>
	<field name="NUMOS" class="java.math.BigDecimal"/>
	<field name="SNENTRADA" class="java.lang.String"/>
	<field name="DTCONCLUSAO" class="java.sql.Timestamp"/>
	<field name="VLRCONSERTO" class="java.lang.Double"/>
	<field name="NUFIN" class="java.math.BigDecimal"/>
	<field name="CODPARC" class="java.math.BigDecimal"/>
	<field name="RAZAOSOCIAL" class="java.lang.String"/>
	<field name="CGC_CPF" class="java.lang.String"/>
	<variable name="TOTAL_CONSERTO" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRCONSERTO}]]></variableExpression>
	</variable>
	<title>
		<band height="110" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="0" width="535" height="24"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[FECHAMENTO DE ASSISTÊNCIA TÉCNICA]]></text>
			</staticText>
			<rectangle>
				<reportElement x="0" y="32" width="535" height="70"/>
				<graphicElement>
					<pen lineWidth="0.75"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement x="8" y="38" width="80" height="16"/>
				<textElement verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Parceiro:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="88" y="38" width="437" height="16"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{CODPARC} + " - " + $F{RAZAOSOCIAL}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="8" y="56" width="80" height="16"/>
				<textElement verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[CNPJ/CPF:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="88" y="56" width="437" height="16"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{CGC_CPF}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="8" y="74" width="80" height="16"/>
				<textElement verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Data de emissão:]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="88" y="74" width="437" height="16"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="22" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="0" y="2" width="70" height="18" backcolor="#E0E0E0"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[NUMOS]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="70" y="2" width="170" height="18" backcolor="#E0E0E0"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[SN ENTRADA]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="240" y="2" width="90" height="18" backcolor="#E0E0E0"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[DT. CONCLUSÃO]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="330" y="2" width="110" height="18" backcolor="#E0E0E0"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[VLR. CONSERTO]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="440" y="2" width="95" height="18" backcolor="#E0E0E0"/>
				<box>
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[NUFIN]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="70" height="18"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{NUMOS} == null ? "" : String.valueOf($F{NUMOS})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="70" y="0" width="170" height="18"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{SNENTRADA}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
				<reportElement x="240" y="0" width="90" height="18"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{DTCONCLUSAO}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="330" y="0" width="110" height="18"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
