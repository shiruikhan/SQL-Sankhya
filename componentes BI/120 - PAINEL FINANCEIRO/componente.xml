<gadget>
  <prompt-parameters>
    <parameter id="P_CODEMP" description="Empresa" metadata="entity:Empresa@CODEMP" required="false" keep-last="true" keep-date="false" order="0" label="P_CODEMP : Entidade/Tabela"/>
    <parameter id="P_DTVENC" description="Período (Baixa - Vencimento)" metadata="datePeriod" required="true" keep-last="true" keep-date="false" order="1" label="P_DTVENC : Período"/>
    <parameter id="P_RECDESP" description="Receitas e Despesas" metadata="singleList:Text" listType="text" required="true" keep-last="true" keep-date="false" order="2" label="P_RECDESP : singleList:Text">
      <item value="1" label="Recebimentos"/>
      <item value="-1" label="Pagamentos"/>
    </parameter>
    <parameter id="P_CODNAT" description="Natureza" metadata="multiList:Text" listType="sql" required="false" keep-last="true" keep-date="false" order="3">
      <expression type="SQL"><![CDATA[SELECT N.CODNAT AS VALUE,	N.DESCRNAT AS LABELFROM TGFNAT NORDER BY N.DESCRNAT]]></expression>
    </parameter>
    <parameter id="P_DTCORTE" description="Data de Corte" metadata="date" required="false" keep-last="false" keep-date="false" order="4"/>
  </prompt-parameters>
