<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EspelhoFINAN" language="groovy" pageWidth="340" pageHeight="105" columnWidth="340" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.5937424601000023"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[SELECT FIN.NUMNOTA,
	FIN.CODEMP,
	FIN.DESDOBRAMENTO,
	trunc(FIN.DTVENC) as DTVENC,
	FIN.VLRDESDOB,
	(SELECT DISTINCT DESCRTIPTIT FROM TGFTIT WHERE CODTIPTIT = FIN.CODTIPTIT) AS DESCRTIPTIT
FROM TGFFIN FIN
WHERE NUNOTA = $P{PK_NUNOTA}
ORDER BY FIN.CODEMP, trunc(FIN.DTVENC)]]>
	</queryString>
	<field name="NUMNOTA" class="java.math.BigDecimal"/>
	<field name="CODEMP" class="java.math.BigDecimal"/>
	<field name="DESDOBRAMENTO" class="java.lang.String"/>
	<field name="DTVENC" class="java.sql.Timestamp"/>
	<field name="VLRDESDOB" class="java.lang.Double"/>
	<field name="DESCRTIPTIT" class="java.lang.String"/>
