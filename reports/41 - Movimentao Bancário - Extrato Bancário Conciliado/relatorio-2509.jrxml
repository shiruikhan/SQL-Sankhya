	<parameter name=":DAT2" class="java.sql.Timestamp" isForPrompting="false"/>
	<parameter name="NOME_MODULO" class="java.lang.String" isForPrompting="false"/>
	<parameter name="FILTER_PARAM_0" class="java.lang.String" isForPrompting="false"/>
	<parameter name="FILTER_PARAM_1" class="java.sql.Timestamp" isForPrompting="false"/>
	<parameter name="FILTER_PARAM_2" class="java.sql.Timestamp" isForPrompting="false"/>
	<parameter name="P0" class="java.lang.String">
		<property name="NOMETABELA" value="TSICTA"/>
		<property name="PESQUISA" value="TRUE"/>
		<parameterDescription><![CDATA[Cód. Conta]]></parameterDescription>
	</parameter>
	<parameter name="P1" class="java.sql.Timestamp">
		<property name="type" value="D"/>
		<parameterDescription><![CDATA[Dt Conciliação >=]]></parameterDescription>
	</parameter>
	<parameter name="P2" class="java.sql.Timestamp">
		<property name="type" value="D"/>
		<parameterDescription><![CDATA[Dt Conciliação <=]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT MBC.CODCTABCOINT AS "Cod. Conta_1",
	CTA.DESCRICAO AS "Descricao_1",
	CTA.CODCTABCO AS "Conta Bancaria",
	CASE WHEN MBC.RECDESP = 1 THEN VLRLANC ELSE 0 END AS "Credito_1",
	CASE WHEN MBC.RECDESP = -1 THEN VLRLANC ELSE 0 END AS "Debito_1",
	MBC.HISTORICO AS "Historico_2",
	NVL((SELECT CASE WHEN COUNT(DISTINCT F.CODPARC) > 1 THEN 'DIVERSOS' ELSE MAX(P.RAZAOSOCIAL) END
	       FROM TGFFIN F
	           INNER JOIN TGFPAR P ON P.CODPARC = F.CODPARC
	      WHERE F.NUBCO = MBC.NUBCO),
	    (SELECT P0.RAZAOSOCIAL FROM TGFPAR P0 WHERE P0.CODPARC = 0)) AS "Historico_1",
	MBC.NUMDOC AS "Num. Docto_1",
	MBC.CODCTABCOINT AS CTASALDOI,
	MBC.DHCONCILIACAO - 1 AS "Saldo Banco",
	MBC.CODCTABCOINT AS CTASALDO,
	MBC.DHCONCILIACAO - 1 AS DTSALDOBCO,
	(MBC.VLRLANC * MBC.RECDESP) AS "Saldo Bco Acum.",
	MBC.DHCONCILIACAO AS "Dt Conciliacao_1"
FROM TGFMBC MBC
	INNER JOIN TSICTA CTA ON MBC.CODCTABCOINT = CTA.CODCTABCOINT
WHERE ((MBC.CODCTABCOINT = $P{P0})
	AND (TRUNC(MBC.DHCONCILIACAO) >= $P{P1})
	AND (TRUNC(MBC.DHCONCILIACAO) <= $P{P2}))
ORDER BY MBC.DHCONCILIACAO, "Historico_1", MBC.NUBCO]]>
	</queryString>
	<field name="Dt Conciliacao_1" class="java.util.Date"/>
	<field name="Num. Docto_1" class="java.math.BigDecimal"/>
	<field name="Debito_1" class="java.lang.Double"/>
	<field name="Credito_1" class="java.lang.Double"/>
	<field name="Saldo Bco Acum." class="java.lang.Double"/>
	<field name="CTASALDO" class="java.lang.Integer"/>
	<field name="DTSALDOBCO" class="java.util.Date"/>
	<field name="Historico_2" class="java.lang.String"/>
	<field name="Historico_1" class="java.lang.String"/>
	<field name="Cod. Conta_1" class="java.lang.Integer"/>
	<field name="Conta Bancaria" class="java.lang.String"/>
	<field name="Descricao_1" class="java.lang.String"/>
	<field name="CTASALDOI" class="java.lang.Integer"/>
	<field name="Saldo Banco" class="java.util.Date"/>
	<variable name="SALDO_INICIAL" class="java.lang.Double" resetType="Group" resetGroup="group_1" calculation="First">
		<variableExpression><![CDATA[br.com.sankhya.modelcore.report.CustomReportUtils.DOUBLEVALUE(br.com.sankhya.modelcore.report.CustomReportUtils.SALDOBCO($F{CTASALDOI}, $F{Saldo Banco}))]]></variableExpression>
	</variable>
	<variable name="MOV_ACUMULADO" class="java.lang.Double" resetType="Group" resetGroup="group_1" calculation="Sum">
		<variableExpression><![CDATA[br.com.sankhya.modelcore.report.CustomReportUtils.DOUBLEVALUE($F{Saldo Bco Acum.})]]></variableExpression>
	</variable>
	<variable name="SALDO_ACUMULADO" class="java.lang.Double" resetType="Group" resetGroup="group_1">
		<variableExpression><![CDATA[new Double($V{SALDO_INICIAL}.doubleValue() + $V{MOV_ACUMULADO}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="TQRExpr_17_0_sum_var" class="java.lang.Double" resetType="Group" resetGroup="group_1" calculation="Sum">
		<variableExpression><![CDATA[br.com.sankhya.modelcore.report.CustomReportUtils.DOUBLEVALUE($F{Debito_1})]]></variableExpression>
	</variable>
