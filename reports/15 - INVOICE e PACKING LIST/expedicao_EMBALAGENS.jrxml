	<field name="QTDPLLT" class="java.math.BigDecimal"/>
	<field name="TOTAL_PKGS" class="java.math.BigDecimal"/>
	<variable name="PESO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOLIQ}]]></variableExpression>
	</variable>
	<variable name="QTDCAIXA_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{GRP_PACKAGE_COUNT} == 1 ? $F{QTDCAIXA} : java.math.BigDecimal.ZERO]]></variableExpression>
	</variable>
	<variable name="PESOBRUTO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOBRUTO}]]></variableExpression>
	</variable>
	<variable name="PESOBRUTOPROD_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOBRUTOPROD}]]></variableExpression>
	</variable>
	<variable name="PESOTOTAL_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PESOBRUTOPROD}]]></variableExpression>
	</variable>
	<variable name="M3_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{M3} != null && $F{QTDCAIXA} != null ? $F{M3}.multiply($F{QTDCAIXA}) : java.math.BigDecimal.ZERO]]></variableExpression>
	</variable>
	<group name="GRP_PACKAGE">
		<groupExpression><![CDATA[$F{PKG} + "|" + ($F{PKG}.equals("BOX") ? $F{CODPROD} : $F{PO}).toString()]]></groupExpression>
