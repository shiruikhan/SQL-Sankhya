<gadget>
  <prompt-parameters>
    <parameter id="P_PERIODO" description="Período de Trabalho" metadata="datePeriod" required="true" keep-last="true" keep-date="false" order="0"/>
    <parameter id="P_DTFAB" description="Período de Fabricação" metadata="datePeriod" required="false" keep-last="false" keep-date="false" order="1"/>
    <parameter id="P_CODGRUPOPROD" description="Grupo PA" metadata="entity:GrupoProduto@CODGRUPOPROD" required="false" keep-last="true" keep-date="false" order="2"/>
    <parameter id="P_CODGRUPOMAPROD" description="Grupo MP" metadata="entity:GrupoProduto@CODGRUPOPROD" required="false" keep-last="true" keep-date="false" order="3"/>
  </prompt-parameters>
  <level id="lvl_asui51x" description="Seletor">
