<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TabSparkProdutos" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="832" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.771561000000001"/>
	<property name="ireport.x" value="119"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo-sk.gif"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="CODGRUPOPROD" class="java.math.BigDecimal">
		<property name="PESQUISA" value="TRUE"/>
		<property name="NOMETABELA" value="TGFGRU"/>
		<parameterDescription><![CDATA[Grupo de Produto]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     P.CODPROD
    ,P.COMPLDESC
    ,P.AD_DESCRPRODOED
    ,P.AD_QTDEMB
    ,P.REFERENCIA
    ,P.NCM
    ,P.AD_PESOLIQ_SPARK
    ,NVL(TRIM(TO_CHAR(P.AD_ESPESSURA_SPARK)), '0') || 'x' ||
     NVL(TRIM(TO_CHAR(P.AD_LARGURA_SPARK)),   '0') || 'x' ||
     NVL(TRIM(TO_CHAR(P.AD_ALTURA_SPARK)),    '0') AS MEDIDA_PRODUTO
    ,P.PESOBRUTO
    ,NVL(TRIM(TO_CHAR(P.ESPESSURA)), '0') || 'x' ||
     NVL(TRIM(TO_CHAR(P.LARGURA)),   '0') || 'x' ||
     NVL(TRIM(TO_CHAR(P.ALTURA)),    '0') AS MEDIDA_CAIXA,
     G.DESCRGRUPOPROD
FROM TGFPRO P
     INNER JOIN TGFGRU G ON P.CODGRUPOPROD = G.CODGRUPOPROD
WHERE P.ATIVO = 'S'
  AND NVL(P.AD_OBSOLETO, 'N') <> 'S'
  AND P.CODGRUPOPROD IN (
      SELECT CODGRUPOPROD
        FROM TGFGRU
       WHERE CODGRUPOPROD = $P{CODGRUPOPROD}
          OR (    CODGRUPAI = $P{CODGRUPOPROD}
              AND (SELECT ANALITICO FROM TGFGRU WHERE CODGRUPOPROD = $P{CODGRUPOPROD}) = 'N'
             )
  )
ORDER BY P.CODPROD]]>
	</queryString>
	<field name="AD_QTDEMB" class="java.math.BigDecimal"/>
	<field name="AD_PESOLIQ_SPARK" class="java.math.BigDecimal"/>
	<field name="PESOBRUTO" class="java.math.BigDecimal"/>
	<field name="COMPLDESC" class="java.lang.String"/>
	<field name="AD_DESCRPRODOED" class="java.lang.String"/>
	<field name="REFERENCIA" class="java.lang.String"/>
	<field name="NCM" class="java.lang.String"/>
