	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false"/>
	<parameter name="NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT (SELECT CB.AD_NUMPS FROM TGFCAB CB WHERE CB.NUNOTA = NVL($P{NUNOTA},$P{PK_NUNOTA})) AS NUMPS,
	c.ad_codlocaldest,
	L.CODLOCAL||'-'||L.DESCRLOCAL AS DESCRLOCAL,
	I.CODPROD,
	P.DESCRPROD,
	P.LOCALIZACAO,
	SUM(I.QTDNEG-I.QTDENTREGUE) AS  QTD,
	DBMS_LOB.SUBSTR(P.AD_OBSTECNICA, 1000, 1) AS AD_OBSTECNICA
FROM TGFCAB C
	LEFT JOIN TGFLOC L ON (C.AD_CODLOCALDEST = L.CODLOCAL)
	INNER JOIN TGFITE I ON (C.NUNOTA = I.NUNOTA)
	INNER JOIN TGFPRO P ON (P.CODPROD = I.CODPROD)
WHERE NVL(C.NUMPEDIDO2,C.AD_NUMPS) IN (SELECT NVL(CAB.NUMPEDIDO2,CAB.AD_NUMPS) FROM TGFCAB CAB WHERE CAB.NUNOTA=NVL($P{NUNOTA},$P{PK_NUNOTA}))
	AND NVL(c.ad_codlocaldest,0) >0
GROUP BY NVL(C.NUMPEDIDO2,C.AD_NUMPS), c.ad_codlocaldest, L.CODLOCAL||'-'||L.DESCRLOCAL, I.CODPROD, P.DESCRPROD, P.LOCALIZACAO, DBMS_LOB.SUBSTR(P.AD_OBSTECNICA, 1000, 1)
ORDER BY c.ad_codlocaldest, P.DESCRPROD, P.LOCALIZACAO, DBMS_LOB.SUBSTR(P.AD_OBSTECNICA, 1000, 1)]]>
	</queryString>
	<field name="NUMPS" class="java.lang.String"/>
	<field name="AD_CODLOCALDEST" class="java.math.BigDecimal"/>
	<field name="DESCRLOCAL" class="java.lang.String"/>
	<field name="CODPROD" class="java.math.BigDecimal"/>
	<field name="DESCRPROD" class="java.lang.String"/>
	<field name="LOCALIZACAO" class="java.lang.String"/>
	<field name="QTD" class="java.math.BigDecimal"/>
	<field name="AD_OBSTECNICA" class="java.lang.String"/>
