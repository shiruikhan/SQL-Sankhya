<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RelatorioPedidoDeCompra" pageWidth="595" pageHeight="842" columnWidth="585" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isFloatColumnFooter="true">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="3.2153832150000383"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="numReg" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(29495)]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["logo-sk.gif"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="NUNOTA" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[SELECT (CASE WHEN ITE.CODVOL = PRO.CODVOL
		THEN ITE.QTDNEG
		ELSE (CASE WHEN VOA.DIVIDEMULTIPLICA = 'M'
			THEN ITE.QTDNEG / VOA.QUANTIDADE
			ELSE ITE.QTDNEG * VOA.QUANTIDADE
			END)
		END) AS QTDNEG,
	PAR.CODPARC,
	CAB.NUMNOTA AS NumeroPedido,
	PAR.NOMEPARC AS NomeParceiro,
	PARBAI.NOMEBAI AS BairroParceiro,
	PAREDN.NOMEEND AS EndercoParceiro,
	PARCID.NOMECID AS CidadeParceiro,
	PAR.NUMEND NroEndParceiro,
	PAR.TELEFONE AS TelParceiro,
	PAR.CGC_CPF AS CGCParceio,
	PAR.IDENTINSCESTAD AS InscParceiro,
	PARUFS.UF AS UfParceiro,
	PAR.CEP AS CepParceiro,
	CAB.DTNEG AS DtNegociacao,
	CAB.DTFATUR AS DtFaturamento,
	TPV.DESCRTIPVENDA AS TipoNegociação,
	VEN.APELIDO AS Comprador,
	ITE.CODPROD AS CodProduto,
	ITE.CODVOL AS Unidade,
	PRO.DESCRPROD AS DescProduto,
	ITE.VLRUNIT AS VlrUnitario,
	CAB.OBSERVACAO AS OBSERVACAO,
	ITE.VLRUNIT,
	ITE.AD_VLRCHEIOCOM,
	ITE.AD_VLROUTROSCOMP AS VLR501,
	CAB.VLRDESCTOT AS DESCONTO,
	(CAB.VLRNOTA + CAB.VLROUTROS + CAB.VLRFRETE - CAB.VLRDESCTOT) AS VLRTOTALNOTA,
	--ITE.AD_VLRCHEIOCOM - ITE.VLRUNIT AS DIFERENCA,
	ITE.VLRTOT,
	CAB.VLRFRETE,
	PAR.OBSERVACOES,
	ITE.AD_VLRCHEIOCOM * (CASE WHEN ITE.CODVOL = PRO.CODVOL
		THEN ITE.QTDNEG
		ELSE (CASE WHEN VOA.DIVIDEMULTIPLICA = 'M'
			THEN ITE.QTDNEG / VOA.QUANTIDADE
			ELSE ITE.QTDNEG * VOA.QUANTIDADE
			END)
		END) AS VLRTOTC
FROM TGFCAB CAB
	INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
	INNER JOIN TGFVEN VEN ON CAB.CODVEND = VEN.CODVEND
	INNER JOIN TSIEND PAREDN ON PAR.CODEND = PAREDN.CODEND
	INNER JOIN TSIBAI PARBAI ON PAR.CODBAI = PARBAI.CODBAI
	INNER JOIN TSICID PARCID ON PAR.CODCID = PARCID.CODCID
	INNER JOIN TSIUFS PARUFS ON PARCID.UF = PARUFS.CODUF
	INNER JOIN TGFTPV TPV ON (TPV.CODTIPVENDA = CAB.CODTIPVENDA AND TPV.DHALTER = CAB.DHTIPVENDA)
	INNER JOIN TGFITE ITE ON ITE.NUNOTA = CAB.NUNOTA
	INNER JOIN TGFPRO PRO ON PRO.CODPROD = ITE.CODPROD
	LEFT JOIN TGFVOA VOA ON (ITE.CODPROD = VOA.CODPROD AND ITE.CODVOL = VOA.CODVOL)
WHERE CAB.NUNOTA = $P{NUNOTA}
ORDER BY ITE.SEQUENCIA]]>
	</queryString>
