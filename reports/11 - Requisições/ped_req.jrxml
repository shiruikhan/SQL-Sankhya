	<parameter name="PK_NUNOTA" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\CLIENTES\\PROTEFER\\19 - PEDIDO DE VENDA\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="NUNOTA" class="java.math.BigDecimal"/>
	<parameter name="PDIR_MODELO" class="java.lang.String">
		<defaultValueExpression><![CDATA["d:\\Developer\\Relatoriso - iReport\\modelos\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
CAB.NUNOTA,
CAB.NUMNOTA,
cab.dtneg,
CAB.CODTIPOPER,
CAB.OBSERVACAO,
(SELECT DISTINCT DESCROPER FROM TGFTOP WHERE CODTIPOPER = CAB.CODTIPOPER) AS DESCROPER,
(CASE WHEN CAB.CODTIPOPER IN (401,406,400,403,411) THEN 'REQUISIÇÃO' WHEN CAB.CODTIPOPER IN (407) THEN 'PERDA' WHEN CAB.CODTIPOPER IN (408,409) THEN 'DEFEITO' WHEN CAB.CODTIPOPER IN (404,405,402) THEN 'TRANSFERÊNCIA' END) AS NOME,
CUS.DESCRCENCUS AS CENTRODECUSTO,
ENE.NOMEEND || ', ' || EMP.NUMEND AS ENDEMP, EMP.RAZAOSOCIAL AS RAZAOSOSCIALEMP,
CIDE.NOMECID ||' - ' || UFSE.UF AS CIDADEEMP,
SUBSTR(EMP.CEP,1,2) || '.' || SUBSTR(EMP.CEP,3,3)||'-'|| SUBSTR(EMP.CEP,6,3) AS CEPEMP,
BAIE.NOMEBAI AS BAIRROEMP,
EMP.INSCESTAD AS INSCRICAOEMP,
EMP.CGC,
EMP.TELEFONE AS TELEFONEEMP,
EMP.FAX AS FAXEMP,
EMP.EMAIL AS EMAILEMP,
EMP.HOMEPAGE,
CAB.CODPARC,
PAR.CEP,
PAR.EMAIL,
PAR.RAZAOSOCIAL,
ENP.NOMEEND ||', '|| PAR.NUMEND AS ENDPARC,
CIDP.NOMECID || ' - ' || UFSP.UF AS CIDADEPARC,
BAIP.NOMEBAI AS BAIRROPARC,
PAR.CGC_CPF,
PAR.TELEFONE AS TELPARC,
PAR.FAX AS FAXPARC,
PAR.INSCESTADNAUF AS INSCESTADPARC,
CAB.CODPARCTRANSP,
PART.RAZAOSOCIAL AS PARCTRANSPORT,
CASE WHEN CAB.CIF_FOB = 'C' THEN 'CIF'
     WHEN CAB.CIF_FOB = 'S' THEN 'Sem frete'
     WHEN CAB.CIF_FOB = 'T' THEN 'Terceiros'
     WHEN CAB.CIF_FOB = 'F' THEN 'FOB' ELSE NULL END AS CIF_FOB,
CASE WHEN CAB.TIPFRETE = 'N' THEN 'Extra Nota' ELSE 'Incluso' END AS TIPFRETE,
CASE WHEN CAB.CODVEND = 0 THEN ' ' ELSE VEN.APELIDO END AS APELIDO,
VEN.EMAIL AS EMAILVEND,
TPV.DESCRTIPVENDA,
NVL(CAB.OBSERVACAO,' ') as OBSERVACAO,
ITE.CODPROD,
PRO.DESCRPROD,
PRO.MARCA,
ITE.CODVOL,
ITE.QTDNEG,
ITE.QTDNEG - ITE.QTDENTREGUE AS SALDO,
--(SELECT SUM(T1.ESTOQUE) FROM TGFEST T1 WHERE T1.CODPROD = ITE.CODPROD AND T1.CODLOCAL = ITE.CODLOCALORIG) AS SALDO,
ITE.CONTROLE,
--ITE.OBSERVACAO AS OBSERVACAOITEM,
PRO.LOCALIZACAO AS OBSERVACAOITEM,
ITE.VLRUNIT,
ITE.VLRTOT
  FROM TGFCAB CAB,
       TSIEMP EMP,
       TSIEND ENE,
       TSICID CIDE,
       TSIUFS UFSE,
       TSIBAI BAIE,
       TGFPAR PAR,
       TSIEND ENP,
       TSICID CIDP,
       TSIUFS UFSP,
       TSIBAI BAIP,
       TGFITE ITE,
       TGFPRO PRO,
       TGFPAR PART,
       TGFVEN VEN,
       TSICUS CUS,
       TGFTPV TPV
 WHERE CAB.CODEMP = EMP.CODEMP
   AND EMP.CODEND = ENE.CODEND
   AND EMP.CODCID = CIDE.CODCID
   AND CIDE.UF = UFSE.CODUF
   AND EMP.CODBAI = BAIE.CODBAI
   AND CAB.CODPARC = PAR.CODPARC
   AND PAR.CODEND = ENP.CODEND
   AND PAR.CODCID = CIDP.CODCID
   AND CIDP.UF = UFSP.CODUF
   AND PAR.CODBAI = BAIP.CODBAI
   AND CAB.NUNOTA = ITE.NUNOTA
   AND ITE.CODPROD = PRO.CODPROD
   AND CAB.CODPARCTRANSP = PART.CODPARC
   AND CAB.CODVEND = VEN.CODVEND
   AND CAB.CODTIPVENDA = TPV.CODTIPVENDA
   AND CAB.DHTIPVENDA = TPV.DHALTER
   AND CAB.CODCENCUS = CUS.CODCENCUS
   AND CAB.NUNOTA = $P{NUNOTA}
   AND (ITE.QTDNEG - ITE.QTDENTREGUE) > 0]]>
	</queryString>
