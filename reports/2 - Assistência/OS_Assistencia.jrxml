<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OS_Assistencia" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="3.138428376721117"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="1674"/>
	<property name="ireport.definition"/>
	<subDataset name="Table Dataset 1"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="NUMOSINI" class="java.math.BigDecimal">
		<parameterDescription><![CDATA[Nr. OS Final]]></parameterDescription>
	</parameter>
	<parameter name="NUMOSFIN" class="java.math.BigDecimal">
		<parameterDescription><![CDATA[Nr. OS Final]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT ASS.CODPARCASS || ' - ' || (SELECT P.NOMEPARC FROM TGFPAR P WHERE P.CODPARC = ASS.CODPARCASS) AS "ASSISTENCIA RESPONSAVEL",
	ASS.DTRECEB AS "DATA DE RECEBIMENTO",
	ASS.NUMOS AS "NR DA OS",
	ASS.CODPARC || ' - ' || PAR.NOMEPARC AS CLIENTE,
	EN.NOMEEND AS RUA,
	PAR.NUMEND AS "NR DA RESIDENCIA",
	CID.NOMECID AS CIDADE,
	UFS.UF AS ESTADO,
	PAR.TELEFONE,
	ASS.SNENTRADA AS "SN DO PRODUTO",
	(SELECT DISTINCT RFINTERNA FROM VGFSERIES WHERE VGFSERIES.SERIE = ASS.SNENTRADA AND MOVIMENTO = 'ENTRADA') AS "REFERENCIA INTERNA",
	(SELECT DISTINCT DESCRPARVENDA FROM VGFSERIES WHERE VGFSERIES.SERIE = ASS.SNENTRADA AND VGFSERIES.MOVIMENTO = 'SAÍDA' AND VGFSERIES.DTVENDA = (SELECT MAX(DTVENDA) FROM VGFSERIES WHERE VGFSERIES.SERIE = ASS.SNENTRADA AND VGFSERIES.MOVIMENTO = 'SAÍDA')) AS REVENDEDOR,
	ASS.NUMNOTAENT AS "NOTA DE ENTRADA",
	(CASE WHEN ASS.STATUS = 'G' THEN 'GARANTIA'
		WHEN ASS.STATUS = 'RN' THEN 'RENOVAÇÃO'
		WHEN ASS.STATUS = 'D' THEN 'DEVOLUÇÃO'
		WHEN ASS.STATUS = 'T' THEN 'TROCA'
		WHEN ASS.STATUS = 'RT' THEN 'RETORNO/TROCA'
		WHEN ASS.STATUS = 'R' THEN 'RETORNO'
		WHEN ASS.STATUS = 'TG' THEN 'TROCA DE GERAÇÃO' END) AS STATUS
FROM AD_TGFASS ASS
	LEFT JOIN TGFPAR PAR ON ASS.CODPARC = PAR.CODPARC
	LEFT JOIN TSIEND EN  ON PAR.CODEND = EN.CODEND
	LEFT JOIN TSICID CID ON PAR.CODCID = CID.CODCID
	LEFT JOIN TSIUFS UFS ON CID.UF = UFS.CODUF
WHERE ASS.NUMOS >= $P{NUMOSINI}
	AND ASS.NUMOS <= $P{NUMOSFIN}]]>
	</queryString>
