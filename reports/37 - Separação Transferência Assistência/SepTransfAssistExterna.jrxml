						<font size="9" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{CODPARC} + " - " + $F{NOMEPARC}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="6" y="22" width="62" height="16"/>
