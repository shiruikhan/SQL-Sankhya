	<field name="VLRTOT" class="java.math.BigDecimal"/>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="DESCITEM" class="java.math.BigDecimal"/>
	<field name="TOTLIQ" class="java.math.BigDecimal"/>
	<field name="VLRUNITLQ" class="java.math.BigDecimal"/>
	<field name="TOTALPRODLIQ" class="java.math.BigDecimal"/>
	<field name="TIPFRETE" class="java.lang.String"/>
